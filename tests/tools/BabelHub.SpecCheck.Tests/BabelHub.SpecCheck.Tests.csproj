<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- Garantiza que SpecCheck se compile antes de las pruebas; no se usa como biblioteca. -->
    <ProjectReference Include="..\..\..\tools\SpecCheck\SpecCheck.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
