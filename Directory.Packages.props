<Project>
  <!-- Versiones centralizadas: los proyectos referencian paquetes sin versión. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="StackExchange.Redis" Version="3.4.29" />
    <PackageVersion Include="Testcontainers" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="MailKit" Version="5.0.0" />
    <PackageVersion Include="AWSSDK.S3" Version="4.1.0" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- UI interactiva de la documentación OpenAPI, solo en Development (publicada el 2026-11-05, más de dos semanas antes de adoptarla). -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
    <!-- El código QR del segundo factor, generado en el servidor (web-acceso D01, DD-120; licencia MIT, publicada el 2026-09-07). -->
    <PackageVersion Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
    <!-- Solo pruebas: un lector independiente del código QR dibujado (web-acceso D05, DD-120; licencia Apache-2.0). -->
    <PackageVersion Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
</Project>
