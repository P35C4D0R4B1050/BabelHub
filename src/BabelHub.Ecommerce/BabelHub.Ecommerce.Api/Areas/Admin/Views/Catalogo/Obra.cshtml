@using BabelHub.Ecommerce.Api.Areas.Admin.Controllers
@model ObraDeAdministracionPagina
@{
    var obra = Model.Obra;
    var aviso = Context.Request.Query["aviso"].ToString();
}
<nav aria-label="Ruta de navegación" class="mb-4 text-sm">
    <a class="link" href="/administracion/obras">Catálogo nacional</a> <span aria-hidden="true">/</span> <span>@obra.Titulo</span>
</nav>

<div class="flex flex-wrap items-start justify-between gap-4">
    <div>
        <h1 class="font-display text-3xl sm:text-4xl">@obra.Titulo</h1>
        <p class="opacity-80">@obra.Autor · @obra.Editorial · @obra.Categoria</p>
        @if (obra.DadaDeBaja)
        {
            <span class="bh-chip mt-2"><bh-icono nombre="candado" clase="size-3.5" />Dada de baja</span>
        }
    </div>
    <div class="bh-portada w-28 bg-base-300">
        <img src="/portadas/@obra.PortadaHuella" alt="Portada de @obra.Titulo" class="size-full object-cover" width="112" height="168" />
    </div>
</div>

@if (obra.Impresa is { RegistroPendienteEnElInventario: true })
{
    <div class="alert alert-warning mt-4" role="status">
        <bh-icono nombre="aviso" />
        <span>El Inventario aún no confirmó el registro de la edición impresa. Se vuelve a intentar al registrar un ingreso.</span>
    </div>
}
@if (aviso == "pendiente")
{
    <div class="alert alert-warning mt-4" role="status"><bh-icono nombre="aviso" /><span>El ingreso quedó pendiente: el Inventario no respondió. Reinténtalo o concílialo desde la pantalla de ingresos.</span></div>
}
@if (obra.DadaDeBaja)
{
    <div class="alert alert-info mt-4" role="status"><bh-icono nombre="info" /><span>Esta obra está dada de baja: ya no se muestra en el catálogo y no se puede editar. Los pedidos y accesos anteriores la conservan.</span></div>
}
else
{
    <section class="mt-8 max-w-3xl" aria-labelledby="h-datos">
        <h2 id="h-datos" class="text-xl font-semibold">Datos de la obra</h2>
        <form class="mt-3 space-y-3" method="post" data-bh-formulario="editar-obra" data-url="/administracion/obras/@obra.ObraId" data-version="@obra.Version" novalidate>
            <div data-bh-errores class="alert alert-error" role="alert" tabindex="-1" hidden></div>
            <div class="grid gap-3 sm:grid-cols-2">
                <div class="sm:col-span-2">
                    <label class="block text-sm font-semibold" for="o-titulo">Título *</label>
                    <input id="o-titulo" name="titulo" class="input w-full" maxlength="200" value="@obra.Titulo" />
                </div>
                <div>
                    <label class="block text-sm font-semibold" for="o-autor">Autor *</label>
                    <input id="o-autor" name="autor" class="input w-full" maxlength="200" value="@obra.Autor" />
                </div>
                <div>
                    <label class="block text-sm font-semibold" for="o-editorial">Editorial *</label>
                    <input id="o-editorial" name="editorial" class="input w-full" maxlength="200" value="@obra.Editorial" />
                </div>
                <div>
                    <label class="block text-sm font-semibold" for="o-categoria">Categoría *</label>
                    <input id="o-categoria" name="categoria" class="input w-full" maxlength="60" value="@obra.Categoria" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-semibold" for="o-descripcion">Descripción (opcional, hasta 600 caracteres, texto plano)</label>
                    <textarea id="o-descripcion" name="descripcion" class="textarea w-full" rows="4" maxlength="600" aria-describedby="o-descripcion-ayuda">@obra.Descripcion</textarea>
                    <p id="o-descripcion-ayuda" class="mt-1 text-xs text-base-content/70">Se muestra en la ficha tal como se escribe. Vacía, la obra queda sin descripción.</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold" for="o-portada">Reemplazar la portada (opcional)</label>
                    <input id="o-portada" name="portada" type="file" accept="image/jpeg,image/png,image/webp" class="file-input w-full" />
                </div>
            </div>
            <button type="submit" class="btn btn-primary btn-sm">Guardar cambios</button>
        </form>
    </section>

    @if (obra.Impresa is { } impresa)
    {
        <section class="mt-10 max-w-3xl rounded-box border border-base-300 p-4" aria-labelledby="h-impresa">
            <h2 id="h-impresa" class="text-xl font-semibold">Edición impresa</h2>
            <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
                <span class="bh-chip">@impresa.Estado</span>
                <span class="font-mono">@impresa.Isbn</span>
                @if (impresa.IsbnIngresado != impresa.Isbn)
                {
                    <span class="opacity-70">(escrito como @impresa.IsbnIngresado)</span>
                }
                @if (impresa.AgotadaEnLaRed)
                {
                    <span class="bh-chip"><bh-icono nombre="agotado" clase="size-3.5" />Agotado en la red</span>
                }
            </div>
            <form class="mt-3 flex flex-wrap items-end gap-3" method="post" data-bh-formulario="editar-edicion" data-url="/administracion/obras/@obra.ObraId/ediciones/@impresa.EdicionId" data-version="@obra.Version" novalidate>
                <div data-bh-errores class="alert alert-error w-full" role="alert" tabindex="-1" hidden></div>
                <div>
                    <label class="block text-sm font-semibold" for="i-precio">Precio (S/)</label>
                    <input id="i-precio" name="precio" class="input w-40" inputmode="decimal" value="@impresa.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Guardar precio</button>
            </form>
            <div class="mt-3 flex flex-wrap gap-2">
                @if (impresa.Activa)
                {
                    <a class="btn btn-sm" href="/administracion/ediciones/@impresa.EdicionId/ingreso">Registrar ingreso</a>
                }
                <form method="post" data-bh-formulario="accion-simple" data-url="/administracion/obras/@obra.ObraId/ediciones/@impresa.EdicionId/baja" data-version="@obra.Version" data-confirmar="¿Dar de baja la edición impresa? Se quita de los carritos y deja de mostrarse." novalidate>
                    <div data-bh-errores class="alert alert-error mb-2" role="alert" tabindex="-1" hidden></div>
                    <button type="submit" class="btn btn-sm btn-ghost">Dar de baja la edición</button>
                </form>
            </div>
        </section>
    }
    else
    {
        <section class="mt-10 max-w-3xl rounded-box border border-base-300 p-4" aria-labelledby="h-agregar-impresa">
            <h2 id="h-agregar-impresa" class="text-xl font-semibold">Agregar edición impresa</h2>
            <form class="mt-3 space-y-3" method="post" data-bh-formulario="agregar-edicion" data-formato="impresa" data-url="/administracion/obras/@obra.ObraId/ediciones" data-version="@obra.Version" novalidate>
                <div data-bh-errores class="alert alert-error" role="alert" tabindex="-1" hidden></div>
                <div class="grid gap-3 sm:grid-cols-3">
                    <div>
                        <label class="block text-sm font-semibold" for="ai-isbn">ISBN *</label>
                        <input id="ai-isbn" name="impresa-isbn" class="input w-full" maxlength="20" inputmode="numeric" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold" for="ai-precio">Precio (S/) *</label>
                        <input id="ai-precio" name="impresa-precio" class="input w-full" inputmode="decimal" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold" for="ai-stock">Stock inicial (opcional)</label>
                        <input id="ai-stock" name="impresa-stock" class="input w-full" type="number" min="1" max="5000" step="1" inputmode="numeric" />
                    </div>
                </div>
                <button type="submit" class="btn btn-sm btn-primary">Agregar edición impresa</button>
            </form>
        </section>
    }

    @if (obra.Digital is { } digital)
    {
        <section class="mt-6 max-w-3xl rounded-box border border-base-300 p-4" aria-labelledby="h-digital">
            <h2 id="h-digital" class="text-xl font-semibold">Edición digital y licencia</h2>
            <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
                <span class="bh-chip">@digital.Estado</span>
                <span class="font-mono">@digital.Isbn</span>
                @if (digital.MotivoDeNoDisponible is not null)
                {
                    <span class="bh-chip"><bh-icono nombre="aviso" clase="size-3.5" />@digital.MotivoDeNoDisponible</span>
                }
                @if (digital.MotivoDeRetiro is not null)
                {
                    <span class="opacity-80">Motivo del retiro: @digital.MotivoDeRetiro</span>
                }
            </div>
            @if (digital.LicenciaTexto is not null)
            {
                <p class="mt-1 text-sm opacity-80">@digital.LicenciaTexto · @digital.Territorios · @(digital.VigenteHasta is not null ? $"vigente hasta {digital.VigenteHasta}" : "sin vencimiento")</p>
            }
            @if (digital.ArchivoTexto is not null)
            {
                <p class="text-sm opacity-80">Libro: @digital.ArchivoTexto</p>
            }
            @if (digital.Activa)
            {
                <form class="mt-4 space-y-3" method="post" data-bh-formulario="editar-edicion" data-url="/administracion/obras/@obra.ObraId/ediciones/@digital.EdicionId" data-version="@obra.Version" novalidate>
                    <div data-bh-errores class="alert alert-error" role="alert" tabindex="-1" hidden></div>
                    <div class="grid gap-3 sm:grid-cols-2">
                        <div>
                            <label class="block text-sm font-semibold" for="d-precio">Precio (S/, sin IGV)</label>
                            <input id="d-precio" name="precio" class="input w-full" inputmode="decimal" value="@digital.Precio.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold" for="d-archivo">Reemplazar el libro (EPUB o PDF, opcional)</label>
                            <input id="d-archivo" name="archivo" type="file" accept=".epub,.pdf,application/epub+zip,application/pdf" class="file-input w-full" />
                        </div>
                    </div>
                    <label class="flex cursor-pointer items-center gap-2 text-sm"><input type="checkbox" name="cambiar-licencia" class="checkbox checkbox-sm" /> Actualizar la licencia</label>
                    <div data-bh-licencia-campos hidden>
                        <partial name="~/Areas/Admin/Views/Catalogo/_CamposDeLicencia.cshtml" model="@(new CamposDeLicenciaVista("licencia-", digital.LicenciaTipo ?? "comercial", digital.FormatoDeLicencia ?? "epub", digital.Titular, digital.Territorios, digital.VigenteHasta))" />
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">Guardar cambios</button>
                </form>
                <div class="mt-4 flex flex-wrap items-end gap-3">
                    <form class="flex flex-wrap items-end gap-2" method="post" data-bh-formulario="accion-simple" data-url="/administracion/obras/@obra.ObraId/ediciones/@digital.EdicionId/retirar" data-confirmar="¿Retirar la edición digital de la venta? Es definitivo; quienes ya la compraron conservan su acceso." novalidate>
                        <div data-bh-errores class="alert alert-error w-full" role="alert" tabindex="-1" hidden></div>
                        <div>
                            <label class="block text-sm font-semibold" for="d-motivo">Motivo del retiro (hasta 300 caracteres)</label>
                            <input id="d-motivo" name="motivo" class="input w-72" maxlength="300" />
                        </div>
                        <button type="submit" class="btn btn-sm btn-outline">Retirar de la venta</button>
                    </form>
                </div>
            }
            @if (digital.Estado != "Dada de baja")
            {
                <form class="mt-3" method="post" data-bh-formulario="accion-simple" data-url="/administracion/obras/@obra.ObraId/ediciones/@digital.EdicionId/baja" data-version="@obra.Version" data-confirmar="¿Dar de baja la edición digital? Deja de mostrarse en el catálogo." novalidate>
                    <div data-bh-errores class="alert alert-error mb-2" role="alert" tabindex="-1" hidden></div>
                    <button type="submit" class="btn btn-sm btn-ghost">Dar de baja la edición</button>
                </form>
            }
        </section>
    }
    else
    {
        <section class="mt-6 max-w-3xl rounded-box border border-base-300 p-4" aria-labelledby="h-agregar-digital">
            <h2 id="h-agregar-digital" class="text-xl font-semibold">Agregar edición digital</h2>
            <form class="mt-3 space-y-3" method="post" data-bh-formulario="agregar-edicion" data-formato="digital" data-url="/administracion/obras/@obra.ObraId/ediciones" data-version="@obra.Version" novalidate>
                <div data-bh-errores class="alert alert-error" role="alert" tabindex="-1" hidden></div>
                <div class="grid gap-3 sm:grid-cols-2">
                    <div>
                        <label class="block text-sm font-semibold" for="ad-isbn">ISBN *</label>
                        <input id="ad-isbn" name="digital-isbn" class="input w-full" maxlength="20" inputmode="numeric" />
                    </div>
                    <div>
                        <label class="block text-sm font-semibold" for="ad-precio">Precio (S/, sin IGV) *</label>
                        <input id="ad-precio" name="digital-precio" class="input w-full" inputmode="decimal" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-sm font-semibold" for="ad-archivo">Libro (EPUB o PDF, hasta 50 MB) *</label>
                        <input id="ad-archivo" name="digital-archivo" type="file" accept=".epub,.pdf,application/epub+zip,application/pdf" class="file-input w-full" />
                    </div>
                </div>
                <partial name="~/Areas/Admin/Views/Catalogo/_CamposDeLicencia.cshtml" model="@(new CamposDeLicenciaVista("digital-", "comercial", "epub", null, null, null))" />
                <button type="submit" class="btn btn-sm btn-primary">Agregar edición digital</button>
            </form>
        </section>
    }

    <section class="mt-10 max-w-3xl border-t border-base-300 pt-4" aria-labelledby="h-baja">
        <h2 id="h-baja" class="text-xl font-semibold">Dar de baja la obra</h2>
        <p class="mt-1 text-sm opacity-80">Da de baja todas sus ediciones y las quita de los carritos. Los pedidos en curso la siguen mostrando y los accesos concedidos se conservan. No se puede deshacer.</p>
        <form class="mt-3" method="post" data-bh-formulario="accion-simple" data-url="/administracion/obras/@obra.ObraId/baja" data-version="@obra.Version" data-destino="/administracion/obras" data-confirmar="¿Dar de baja la obra completa? No se puede deshacer." novalidate>
            <div data-bh-errores class="alert alert-error mb-2" role="alert" tabindex="-1" hidden></div>
            <button type="submit" class="btn btn-sm btn-error btn-outline">Dar de baja la obra</button>
        </form>
    </section>
}

@section Scripts {
    <script src="/js/admin-catalogo.js" defer></script>
}
