@using BabelHub.Ecommerce.Api.Areas.Admin.Controllers
@model NuevaObraVista
<nav aria-label="Ruta de navegación" class="mb-4 text-sm">
    <a class="link" href="/administracion/obras">Catálogo nacional</a> <span aria-hidden="true">/</span> <span>Nueva obra</span>
</nav>
<h1 class="font-display text-3xl sm:text-4xl">Nueva obra</h1>
<p class="mt-1 max-w-2xl opacity-80">Una obra lleva su portada y al menos una edición. Los archivos se suben primero y quedan ligados a ti por 24 horas.</p>

<form class="mt-6 max-w-3xl space-y-6" method="post" data-bh-formulario="alta-obra" novalidate>
    <div data-bh-errores class="alert alert-error" role="alert" tabindex="-1" hidden></div>

    <fieldset class="grid gap-3 sm:grid-cols-2">
        <legend class="mb-1 text-lg font-semibold">Obra</legend>
        <div class="sm:col-span-2">
            <label class="block text-sm font-semibold" for="o-titulo">Título *</label>
            <input id="o-titulo" name="titulo" class="input w-full" maxlength="200" required />
        </div>
        <div>
            <label class="block text-sm font-semibold" for="o-autor">Autor *</label>
            <input id="o-autor" name="autor" class="input w-full" maxlength="200" required />
        </div>
        <div>
            <label class="block text-sm font-semibold" for="o-editorial">Editorial *</label>
            <input id="o-editorial" name="editorial" class="input w-full" maxlength="200" required />
        </div>
        <div>
            <label class="block text-sm font-semibold" for="o-categoria">Categoría *</label>
            <input id="o-categoria" name="categoria" class="input w-full" maxlength="60" required />
        </div>
        <div>
            <label class="block text-sm font-semibold" for="o-portada">Portada (JPEG, PNG o WebP, hasta 2 MB) *</label>
            <input id="o-portada" name="portada" type="file" accept="image/jpeg,image/png,image/webp" class="file-input w-full" required />
        </div>
    </fieldset>

    <fieldset class="space-y-3 rounded-box border border-base-300 p-4">
        <legend class="px-1 text-lg font-semibold">Edición impresa</legend>
        <label class="flex cursor-pointer items-center gap-2"><input type="checkbox" name="impresa-on" class="checkbox checkbox-sm checkbox-primary" /> Tiene edición impresa</label>
        <div class="grid gap-3 sm:grid-cols-2" data-bh-seccion="impresa" hidden>
            <div>
                <label class="block text-sm font-semibold" for="i-isbn">ISBN *</label>
                <input id="i-isbn" name="impresa-isbn" class="input w-full" maxlength="20" inputmode="numeric" />
            </div>
            <div>
                <label class="block text-sm font-semibold" for="i-precio">Precio (S/) *</label>
                <input id="i-precio" name="impresa-precio" class="input w-full" inputmode="decimal" />
            </div>
            <div class="sm:col-span-2">
                <label class="block text-sm font-semibold" for="i-stock">Stock inicial (opcional, de 1 a 5 000)</label>
                <input id="i-stock" name="impresa-stock" class="input w-full sm:w-64" type="number" min="1" max="5000" step="1" inputmode="numeric" aria-describedby="i-stock-ayuda" />
                <p id="i-stock-ayuda" class="mt-1 text-xs opacity-70">Entra a la fuente de recepción como un ingreso auditado. Los lotes siguientes se registran con «Registrar ingreso»; el stock no se edita aquí. Si el Inventario no responde, la edición se crea igual y verás el aviso de ingreso pendiente.</p>
            </div>
        </div>
    </fieldset>

    <fieldset class="space-y-3 rounded-box border border-base-300 p-4">
        <legend class="px-1 text-lg font-semibold">Edición digital y licencia</legend>
        <label class="flex cursor-pointer items-center gap-2"><input type="checkbox" name="digital-on" class="checkbox checkbox-sm checkbox-primary" /> Tiene edición digital</label>
        <div class="space-y-3" data-bh-seccion="digital" hidden>
            <div class="grid gap-3 sm:grid-cols-2">
                <div>
                    <label class="block text-sm font-semibold" for="d-isbn">ISBN *</label>
                    <input id="d-isbn" name="digital-isbn" class="input w-full" maxlength="20" inputmode="numeric" />
                </div>
                <div>
                    <label class="block text-sm font-semibold" for="d-precio">Precio (S/, sin IGV) *</label>
                    <input id="d-precio" name="digital-precio" class="input w-full" inputmode="decimal" />
                </div>
                <div class="sm:col-span-2">
                    <label class="block text-sm font-semibold" for="d-archivo">Libro (EPUB o PDF, hasta 50 MB) *</label>
                    <input id="d-archivo" name="digital-archivo" type="file" accept=".epub,.pdf,application/epub+zip,application/pdf" class="file-input w-full" />
                </div>
            </div>
            <partial name="~/Areas/Admin/Views/Catalogo/_CamposDeLicencia.cshtml" model="@(new CamposDeLicenciaVista("digital-", "comercial", "epub", null, null, null))" />
        </div>
    </fieldset>

    <div class="flex flex-wrap gap-3">
        <button type="submit" class="btn btn-primary">Guardar obra</button>
        <a class="btn btn-ghost" href="/administracion/obras">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script src="/js/admin-catalogo.js" defer></script>
}
