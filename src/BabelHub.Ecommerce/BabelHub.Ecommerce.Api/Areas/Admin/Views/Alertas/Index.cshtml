@using BabelHub.Ecommerce.Api.Web.Estados
@model BabelHub.Ecommerce.Api.Areas.Admin.Controllers.AlertasVista
<h1 class="bh-display">Alertas de seguridad</h1>
<p class="mt-2 max-w-2xl opacity-80">Eventos de seguridad que pasaron el umbral. Marca una alerta como revisada cuando la hayas atendido: solo se dan por vistas las ocurrencias que ya aparecían.</p>

@if (Model.Mensaje is not null)
{
    <div class="alert @(Model.EsError ? "alert-error" : "alert-success") alert-soft mt-4" role="@(Model.EsError ? "alert" : "status")" tabindex="-1" data-bh-foco-inicial><bh-icono nombre="@(Model.EsError ? "error" : "exito")" /><span>@Model.Mensaje</span></div>
}

@if (Model.Pagina.Aviso is not null)
{
    <div class="alert alert-warning mt-4" role="alert"><bh-icono nombre="aviso" /><span>@Model.Pagina.Aviso</span></div>
}

<div class="mt-4" aria-live="polite">
    @if (Model.Estado.Estado != EstadoDePantalla.Exito)
    {
        <vc:bh-estado modelo="@Model.Estado" />
    }
    else
    {
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100" tabindex="0" role="region" aria-label="Alertas de seguridad (se desplaza en horizontal)">
            <table class="table">
                <caption class="sr-only">Alertas de seguridad</caption>
                <thead>
                    <tr><th scope="col">Alerta</th><th scope="col">Servicio</th><th scope="col">Primera</th><th scope="col">Última</th><th scope="col">Ocurrencias</th><th scope="col">Estado</th><th scope="col"><span class="sr-only">Acciones</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var alerta in Model.Pagina.Alertas)
                    {
                        <tr>
                            <td>@alerta.Motivo</td>
                            <td>@alerta.Servicio</td>
                            <td class="whitespace-nowrap">@alerta.PrimeraOcurrencia</td>
                            <td class="whitespace-nowrap">@alerta.UltimaOcurrencia</td>
                            <td>@alerta.Ocurrencias (@alerta.SinRevisar sin revisar)</td>
                            <td>@(alerta.Pendiente ? "Pendiente de revisar" : "Revisada" + (alerta.RevisadaEn is null ? string.Empty : " el " + alerta.RevisadaEn))</td>
                            <td>
                                @if (alerta.Pendiente)
                                {
                                    <form method="post" action="/administracion/alertas/revisada">
                                        <partial name="_TokenAntifalsificacion" />
                                        <input type="hidden" name="alertaId" value="@alerta.Id" />
                                        <input type="hidden" name="contadorVisto" value="@alerta.ContadorVisto" />
                                        <button type="submit" class="btn btn-sm btn-outline">Marcar como revisada</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Pagina.SiguienteCursor is not null)
        {
            <p class="mt-4"><a class="btn btn-outline btn-sm" href="/administracion/alertas?cursor=@Uri.EscapeDataString(Model.Pagina.SiguienteCursor)">Ver más antiguas</a></p>
        }
    }
</div>
