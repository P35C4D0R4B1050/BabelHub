@using BabelHub.Ecommerce.Application.Identidad
@using BabelHub.Ecommerce.Api.Web.Formato
@model BabelHub.Ecommerce.Api.Areas.Admin.Controllers.UsuariosVista
@functions {
    static string TextoDelRol(RolDeCuenta rol) => rol switch
    {
        RolDeCuenta.Cliente => "Cliente",
        RolDeCuenta.EncargadoDeSucursal => "Encargado de sucursal",
        RolDeCuenta.Logistica => "Personal de logística",
        _ => "Administración central",
    };
}
<h1 class="bh-display">Usuarios y roles</h1>
<p class="mt-2 max-w-2xl opacity-80">Crea usuarios del personal, cambia su rol y sucursal, desactívalos o restablece su contraseña o su segundo factor. Cada acción queda en la auditoría.</p>

@if (Model.Mensaje is not null)
{
    <div class="alert @(Model.EsError ? "alert-error" : "alert-success") alert-soft mt-4" role="@(Model.EsError ? "alert" : "status")" tabindex="-1" data-bh-foco-inicial><bh-icono nombre="@(Model.EsError ? "error" : "exito")" /><span>@Model.Mensaje</span></div>
}

@if (Model.Usuario is { } u)
{
    <section class="mt-6 rounded-box border border-base-300 p-4" aria-label="Resultado">
        <dl class="grid grid-cols-1 gap-2 sm:grid-cols-[12rem_1fr]">
            <dt class="font-semibold">Identificador</dt><dd class="font-mono">@u.UsuarioId.ToString("D")</dd>
            <dt class="font-semibold">Nombre</dt><dd>@u.Nombre</dd>
            <dt class="font-semibold">Correo</dt><dd>@u.Correo</dd>
            <dt class="font-semibold">Rol</dt><dd>@TextoDelRol(u.Rol)</dd>
            <dt class="font-semibold">Sucursal</dt><dd>@(u.Sucursal?.ToString("D") ?? "—")</dd>
            <dt class="font-semibold">Estado</dt><dd>@(u.Activo ? "Activo" : "Desactivado")</dd>
        </dl>
        @if (Model.ContrasenaTemporal is not null)
        {
            <div class="alert alert-warning mt-4" role="alert">
                <bh-icono nombre="aviso" />
                <span>Contraseña temporal (solo se muestra ahora, vence el @(Model.ContrasenaVenceEn is { } vence ? FormatoPeruano.FechaYHora(vence) : "—")): <strong class="font-mono text-lg">@Model.ContrasenaTemporal</strong></span>
            </div>
        }
    </section>
}

<h2 class="mt-10 font-display text-2xl">Personal registrado</h2>
@if (Model.ListaNoDisponible)
{
    <div class="alert alert-warning alert-soft mt-3" role="status"><bh-icono nombre="aviso" /><span>No pudimos leer la lista ahora. Puedes seguir usando las acciones con el identificador del usuario.</span></div>
}
else if (Model.Lista is { Usuarios.Count: 0 })
{
    <p class="mt-3 opacity-80">Todavía no hay personal registrado.</p>
}
else if (Model.Lista is { } lista)
{
    <div class="mt-3 overflow-x-auto rounded-box border border-base-300" tabindex="0" role="region" aria-label="Personal registrado (se desplaza en horizontal)">
        <table class="table">
            <caption class="sr-only">Personal registrado, ordenado por correo</caption>
            <thead><tr><th scope="col">Correo</th><th scope="col">Nombre</th><th scope="col">Rol</th><th scope="col">Estado</th><th scope="col">Identificador</th></tr></thead>
            <tbody>
                @foreach (var fila in lista.Usuarios)
                {
                    <tr>
                        <td>@fila.Correo</td>
                        <td>@fila.Nombre</td>
                        <td>@TextoDelRol(fila.Rol)@(fila.Sucursal is not null ? " · con sucursal" : string.Empty)</td>
                        <td>@(fila.Activo ? "Activo" : "Desactivado")</td>
                        <td class="font-mono text-xs">@fila.UsuarioId.ToString("D")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (lista.Siguiente is not null)
    {
        <p class="mt-2 text-sm opacity-80">Se muestran los primeros @FiltroDeUsuarios.TamanoMaximo. Para otra persona usa su identificador en las acciones de abajo.</p>
    }
}

<h2 class="mt-10 font-display text-2xl">Crear un usuario del personal</h2>
<form method="post" action="/administracion/usuarios/crear" class="mt-3 flex max-w-lg flex-col gap-4">
    <partial name="_TokenAntifalsificacion" />
    <label class="form-control"><span class="label-text">Nombre completo</span><input type="text" name="nombre" class="input input-bordered w-full" required maxlength="120" /></label>
    <label class="form-control"><span class="label-text">Correo electrónico</span><input type="email" name="correo" class="input input-bordered w-full" required maxlength="254" autocomplete="off" /></label>
    <label class="form-control"><span class="label-text">Rol</span>
        <select name="rol" class="select select-bordered w-full" required>
            <option value="EncargadoDeSucursal">Encargado de sucursal</option>
            <option value="Logistica">Personal de logística</option>
            <option value="AdministradorCentral">Administración central</option>
        </select>
    </label>
    <label class="form-control"><span class="label-text">Sucursal (código, solo para encargados)</span><input type="text" name="sucursal" class="input input-bordered w-full" maxlength="40" /></label>
    <button type="submit" class="btn btn-primary">Crear y mostrar la contraseña temporal</button>
</form>

<h2 class="mt-10 font-display text-2xl">Cambiar el rol de un usuario</h2>
<form method="post" action="/administracion/usuarios/rol" class="mt-3 flex max-w-lg flex-col gap-4">
    <partial name="_TokenAntifalsificacion" />
    <label class="form-control"><span class="label-text">Identificador del usuario</span><input type="text" name="usuarioId" class="input input-bordered w-full" required maxlength="36" /></label>
    <label class="form-control"><span class="label-text">Rol nuevo</span>
        <select name="rol" class="select select-bordered w-full" required>
            <option value="Cliente">Cliente</option>
            <option value="EncargadoDeSucursal">Encargado de sucursal</option>
            <option value="Logistica">Personal de logística</option>
            <option value="AdministradorCentral">Administración central</option>
        </select>
    </label>
    <label class="form-control"><span class="label-text">Sucursal (código, solo para encargados)</span><input type="text" name="sucursal" class="input input-bordered w-full" maxlength="40" /></label>
    <button type="submit" class="btn btn-outline">Cambiar el rol</button>
</form>

<h2 class="mt-10 font-display text-2xl">Otras acciones sobre un usuario</h2>
<form method="post" class="mt-3 flex max-w-lg flex-col gap-4" asp-antiforgery="false">
    <partial name="_TokenAntifalsificacion" />
    <label class="form-control"><span class="label-text">Identificador del usuario</span><input type="text" name="usuarioId" class="input input-bordered w-full" required maxlength="36" /></label>
    <div class="flex flex-wrap gap-3">
        <button type="submit" class="btn btn-outline" formaction="/administracion/usuarios/desactivar">Desactivar</button>
        <button type="submit" class="btn btn-outline" formaction="/administracion/usuarios/reactivar">Reactivar</button>
        <button type="submit" class="btn btn-outline" formaction="/administracion/usuarios/contrasena">Restablecer la contraseña</button>
        <button type="submit" class="btn btn-outline" formaction="/administracion/usuarios/segundo-factor">Restablecer el segundo factor</button>
    </div>
</form>
