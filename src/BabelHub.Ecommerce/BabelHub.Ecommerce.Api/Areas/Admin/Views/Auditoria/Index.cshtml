@using BabelHub.Ecommerce.Api.Web.Estados
@model BabelHub.Ecommerce.Api.Areas.Admin.Controllers.AuditoriaVista
@{
    string F(string clave) => Model.Filtros.GetValueOrDefault(clave) ?? string.Empty;
}
<h1 class="bh-display">Auditoría</h1>
<p class="mt-2 max-w-2xl opacity-80">Registros del E-commerce y del Inventario, de lo más reciente a lo más antiguo. Las horas son de Lima.</p>

<form method="get" action="/administracion/auditoria" class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="search" aria-label="Filtrar la auditoría">
    <div><label class="block text-sm font-semibold" for="f-accion">Acción</label><input id="f-accion" name="accion" type="text" class="input w-full" maxlength="64" value="@F("accion")" /></div>
    <div><label class="block text-sm font-semibold" for="f-usuario">Usuario (identificador)</label><input id="f-usuario" name="usuario" type="text" class="input w-full" maxlength="36" value="@F("usuario")" /></div>
    <div><label class="block text-sm font-semibold" for="f-origen">Origen</label><input id="f-origen" name="origen" type="text" class="input w-full" maxlength="64" value="@F("origen")" /></div>
    <div><label class="block text-sm font-semibold" for="f-desde">Desde</label><input id="f-desde" name="desde" type="date" class="input w-full" value="@F("desde")" /></div>
    <div><label class="block text-sm font-semibold" for="f-hasta">Hasta</label><input id="f-hasta" name="hasta" type="date" class="input w-full" value="@F("hasta")" /></div>
    <div><label class="block text-sm font-semibold" for="f-texto">Texto</label><input id="f-texto" name="texto" type="search" class="input w-full" maxlength="100" value="@F("texto")" /></div>
    <div class="flex items-end gap-2"><button type="submit" class="btn btn-primary btn-sm">Filtrar</button><a class="btn btn-ghost btn-sm" href="/administracion/auditoria">Limpiar</a></div>
</form>

@if (Model.Pagina.Aviso is not null)
{
    <div class="alert alert-warning mt-4" role="alert"><bh-icono nombre="aviso" /><span>@Model.Pagina.Aviso</span></div>
}

<div class="mt-4" aria-live="polite">
    @if (Model.Estado.Estado != EstadoDePantalla.Exito)
    {
        <vc:bh-estado modelo="@Model.Estado" />
    }
    else
    {
        <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
            <table class="table table-sm">
                <caption class="sr-only">Registros de auditoría</caption>
                <thead>
                    <tr><th scope="col">Hora (Lima)</th><th scope="col">Servicio</th><th scope="col">Acción</th><th scope="col">Usuario</th><th scope="col">Resultado</th><th scope="col">Objeto</th><th scope="col">Detalle</th></tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Pagina.Filas)
                    {
                        <tr>
                            <td class="whitespace-nowrap">@fila.HoraDeLima</td>
                            <td>@fila.Servicio</td>
                            <td>@fila.Accion</td>
                            <td>@fila.Usuario@(fila.Rol is null ? string.Empty : " (" + fila.Rol + ")")@(fila.Anonimizado ? " · anonimizado" : string.Empty)</td>
                            <td>@fila.Resultado@(fila.Motivo is null ? string.Empty : ": " + fila.Motivo)</td>
                            <td>@fila.Objeto</td>
                            <td>
                                @if (fila.Detalle.Count > 0)
                                {
                                    <dl class="text-xs">
                                        @foreach (var dato in fila.Detalle)
                                        {
                                            <dt class="inline font-semibold">@dato.Clave:</dt><dd class="inline">@dato.Valor</dd><br />
                                        }
                                    </dl>
                                }
                                @if (fila.DetalleTruncado)
                                {
                                    <span class="text-xs">(detalle recortado)</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Pagina.SiguienteCursor is not null)
        {
            <p class="mt-4"><a class="btn btn-outline btn-sm" href="@Model.EnlaceDeLaSiguiente">Ver más antiguos</a></p>
        }
    }
</div>
