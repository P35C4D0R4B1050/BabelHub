@using BabelHub.Ecommerce.Api.Areas.Tienda.Controllers
@model ReclamacionNuevaVista
<h1 class="font-display text-4xl leading-tight sm:text-5xl">Libro de Reclamaciones</h1>
<p class="my-4 max-w-prose">Registra aquí un reclamo (por el producto o el servicio) o una queja (por la atención). Te daremos un número y responderemos en un máximo de 15 días calendario. No escribas datos personales que no sean necesarios.</p>
<aside class="alert my-4 max-w-prose items-start" aria-labelledby="aviso-de-datos-del-libro">
    <bh-icono nombre="info" />
    <div class="text-sm">
        <h2 id="aviso-de-datos-del-libro" class="font-semibold">Cómo usamos tus datos (Ley N.° 29733)</h2>
        <ul class="mt-1 flex flex-col gap-1">
            <li><strong>Finalidad:</strong> atender tu reclamo o queja y responderte por correo.</li>
            <li><strong>Base legal:</strong> la obligación de llevar un Libro de Reclamaciones y tu consentimiento al enviar este formulario.</li>
            <li><strong>Conservación:</strong> guardamos la hoja dos años y luego anonimizamos tus datos personales.</li>
            <li><strong>Destinatarios:</strong> la administración de la tienda y, para enviarte la respuesta, el proveedor de correo electrónico que usamos (tu correo y el texto de la respuesta pasan por él).</li>
            <li><strong>Tus derechos:</strong> puedes ejercer tus derechos de acceso, rectificación, cancelación y oposición escribiendo a la administración de la tienda desde la <a class="link" href="/legal/privacidad">política de privacidad</a>.</li>
            <li><strong>Quién puede ver tu hoja:</strong> si la registras con tu sesión, queda vinculada a tu cuenta. Si no, la hoja y su respuesta serán visibles para quien verifique el correo de contacto que escribas.</li>
        </ul>
    </div>
</aside>

@if (Model.CamposConProblema.Count > 0)
{
    <div class="alert alert-error my-6" role="alert" tabindex="-1" data-bh-foco-inicial>
        <bh-icono nombre="error" />
        <div>
            <h2 class="font-semibold">Revisa estos datos</h2>
            <ul class="list-disc pl-5">
                @foreach (var campo in Model.CamposConProblema)
                {
                    <li>@TextosDeReclamaciones.Campo(campo): falta o no es válido.</li>
                }
            </ul>
        </div>
    </div>
}

<form method="post" action="/reclamaciones/nueva" class="flex max-w-xl flex-col gap-6" id="formulario-de-reclamacion">
        <partial name="_TokenAntifalsificacion" />
    <input type="hidden" name="claveDelFormulario" value="@Model.ClaveDelFormulario" />
    <fieldset class="flex flex-col gap-4 rounded-box border border-base-300 p-4">
        <legend class="px-2 font-semibold">1. Identificación del consumidor</legend>
        <label class="form-control flex flex-col gap-1"><span class="label-text">Nombre completo</span><input type="text" name="nombre" class="input input-bordered" required maxlength="120" autocomplete="name" /></label>
        <label class="form-control flex flex-col gap-1"><span class="label-text">Documento de identidad</span><input type="text" name="documento" class="input input-bordered" required maxlength="20" autocomplete="off" /></label>
        <label class="form-control flex flex-col gap-1"><span class="label-text">Domicilio</span><input type="text" name="domicilio" class="input input-bordered" required maxlength="200" autocomplete="street-address" /></label>
        <label class="form-control flex flex-col gap-1"><span class="label-text">Correo electrónico</span><input type="email" name="correo" class="input input-bordered" required maxlength="254" autocomplete="email" /></label>
    </fieldset>
    <fieldset class="flex flex-col gap-4 rounded-box border border-base-300 p-4">
        <legend class="px-2 font-semibold">2. Identificación del bien contratado</legend>
        <label class="form-control flex flex-col gap-1"><span class="label-text">Bien contratado</span><input type="text" name="bienContratado" class="input input-bordered" required maxlength="200" value="@Model.Valor("bienContratado")" /></label>
        <label class="form-control flex flex-col gap-1"><span class="label-text">Monto reclamado (S/)</span><input type="text" inputmode="decimal" name="montoReclamado" class="input input-bordered" required pattern="\d{1,10}(\.\d{1,2})?" value="@Model.Valor("montoReclamado")" /></label>
        <label class="form-control flex flex-col gap-1"><span class="label-text">Referencia del pedido (opcional)</span><input type="text" name="pedidoReferencia" class="input input-bordered" maxlength="40" value="@Model.Valor("pedidoReferencia")" /></label>
    </fieldset>
    <fieldset class="flex flex-col gap-4 rounded-box border border-base-300 p-4">
        <legend class="px-2 font-semibold">3. Detalle de la reclamación</legend>
        <div class="flex flex-col gap-2" role="radiogroup" aria-label="Tipo de reclamación">
            <label class="label cursor-pointer justify-start gap-3"><input type="radio" name="tipo" value="reclamo" class="radio" required checked="@(Model.Valor("tipo") == "reclamo")" /> <span>Reclamo: disconformidad con un producto o servicio</span></label>
            <label class="label cursor-pointer justify-start gap-3"><input type="radio" name="tipo" value="queja" class="radio" checked="@(Model.Valor("tipo") == "queja")" /> <span>Queja: malestar por la atención recibida</span></label>
        </div>
        <label class="form-control flex flex-col gap-1"><span class="label-text">Detalle</span><textarea name="detalle" class="textarea textarea-bordered" rows="6" required maxlength="3000">@Model.Valor("detalle")</textarea></label>
    </fieldset>
    <verificacion-de-persona></verificacion-de-persona>
    <button type="submit" class="btn btn-primary">Registrar hoja</button>
</form>
