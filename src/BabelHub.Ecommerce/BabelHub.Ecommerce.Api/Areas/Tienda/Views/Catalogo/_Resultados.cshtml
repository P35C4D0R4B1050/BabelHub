@model BabelHub.Ecommerce.Api.Areas.Tienda.Controllers.CatalogoVista
@if (Model.AvisoDeFiltros is not null)
{
    <div class="alert alert-warning mb-4" role="alert">
        <bh-icono nombre="aviso" />
        <span>@Model.AvisoDeFiltros</span>
    </div>
}
@if (Model.Estado is not null)
{
    <vc:bh-estado modelo="@Model.Estado" />
}
else
{
    <p class="mb-3 text-sm opacity-80" id="resumen">@Model.Total @(Model.Total == 1 ? "título" : "títulos")@(Model.Filtros.Texto is { } q ? $" para «{q}»" : string.Empty)</p>
    @if (Model.DisponibilidadDudosa)
    {
        <div class="alert alert-warning mb-4" role="status">
            <bh-icono nombre="aviso" />
            <span>No podemos confirmar el stock de algunos títulos en este momento: la disponibilidad que ves puede estar desactualizada.</span>
        </div>
    }
    <ul class="bh-grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
        @foreach (var obra in Model.Tarjetas)
        {
            <li class="bh-celda">
                <a href="/catalogo/obras/@obra.ObraId" class="block" aria-label="Ver @obra.Titulo">
                    <div class="bh-portada bg-base-300">
                        <img src="/portadas/@obra.PortadaHuella" alt="Portada de @obra.Titulo" class="size-full object-cover" width="200" height="300" loading="lazy" />
                    </div>
                </a>
                <h2 class="font-display text-lg leading-tight"><a class="link link-hover" href="/catalogo/obras/@obra.ObraId">@obra.Titulo</a></h2>
                <p class="text-sm opacity-80">@obra.Autor</p>
                <p class="text-sm font-semibold">@obra.DesdeTexto</p>
                <ul class="mt-auto flex flex-col gap-1">
                    @foreach (var edicion in obra.Ediciones)
                    {
                        <li class="flex flex-wrap items-center gap-1 text-xs">
                            <span class="font-semibold">@(edicion.EsDigital ? "Digital" : "Impreso")</span>
                            <vc:bh-disponibilidad modelo="@edicion.Disponibilidad" />
                        </li>
                    }
                </ul>
            </li>
        }
    </ul>
    @if (Model.TotalDePaginas > 1)
    {
        <nav class="mt-6 flex items-center justify-between gap-3" aria-label="Paginación">
            @if (Model.Pagina > 1)
            {
                <a class="btn btn-sm" rel="prev" href="@Model.RutaDeLaPagina(Model.Pagina - 1)" hx-get="@Model.RutaDeLaPagina(Model.Pagina - 1)" hx-target="#resultados" hx-push-url="true">Anterior</a>
            }
            else
            {
                <span></span>
            }
            <span class="text-sm">Página @Model.Pagina de @Model.TotalDePaginas</span>
            @if (Model.Pagina < Model.TotalDePaginas)
            {
                <a class="btn btn-sm" rel="next" href="@Model.RutaDeLaPagina(Model.Pagina + 1)" hx-get="@Model.RutaDeLaPagina(Model.Pagina + 1)" hx-target="#resultados" hx-push-url="true">Siguiente</a>
            }
            else
            {
                <span></span>
            }
        </nav>
    }
}
