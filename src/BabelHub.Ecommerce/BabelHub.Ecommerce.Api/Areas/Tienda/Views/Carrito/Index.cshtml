@using BabelHub.Ecommerce.Api.Web.Estados
@model BabelHub.Ecommerce.Api.Areas.Tienda.Controllers.CarritoVista
<h1 class="font-display text-4xl leading-tight sm:text-5xl">Tu carrito</h1>
<p class="mt-2 mb-6 max-w-2xl opacity-80">Se conserva mientras no lo cambies: puedes mezclar libros impresos y digitales.@(Model.HaySesion ? " Lo ves igual desde tu celular o tu computadora." : " Inicia sesión para verlo desde cualquier dispositivo.")</p>

@if (Model.Avisos.Count > 0)
{
    <section class="mb-6 space-y-3" aria-label="Avisos sobre tu carrito" aria-live="polite">
        @foreach (var aviso in Model.Avisos)
        {
            <div class="alert alert-info alert-vertical sm:alert-horizontal" role="status">
                <bh-icono nombre="info" />
                <span>@aviso.Texto</span>
                <bh-accion-de-cambio>
                    <form method="post" action="/carrito/avisos/@aviso.Id.ToString("D")/visto">
                        <partial name="_TokenAntifalsificacion" />
                        <button type="submit" class="btn btn-sm">Entendido</button>
                    </form>
                </bh-accion-de-cambio>
            </div>
        }
    </section>
}

@if (Model.AlertaTitulo is not null)
{
    <div class="alert alert-warning alert-vertical sm:alert-horizontal mb-6" role="alert" tabindex="-1" id="aviso-del-carrito" data-bh-foco-inicial>
        <bh-icono nombre="aviso" />
        <div>
            <h2 class="font-semibold">@Model.AlertaTitulo</h2>
            <p>@Model.AlertaMensaje</p>
        </div>
    </div>
}

@if (Model.PreciosNoConfirmados)
{
    <div class="alert alert-warning mb-6" role="status">
        <bh-icono nombre="aviso" />
        <span>No pudimos confirmar los precios ahora. Tu carrito sigue igual; inténtalo de nuevo en unos minutos.</span>
        <a class="btn btn-sm" href="/carrito"><bh-icono nombre="reintentar" clase="size-4" />Reintentar</a>
    </div>
}

@if (Model.Estado is not null)
{
    <vc:bh-estado modelo="@Model.Estado" />
}
else
{
    <div class="grid items-start gap-8 lg:grid-cols-[1fr_22rem]">
        <section aria-label="Libros en tu carrito" class="rounded-box border border-base-300 bg-base-100">
            <p class="sr-only" role="status" data-bh-anuncio></p>
            <ul class="divide-y divide-base-300">
                @foreach (var linea in Model.Lineas)
                {
                    var etiqueta = $"«{linea.Titulo}»";
                    <li class="flex flex-col gap-3 p-4 sm:flex-row">
                        <div class="flex min-w-0 flex-1 gap-4">
                            <div class="grid h-24 w-16 shrink-0 place-items-center rounded-box bg-base-300" aria-hidden="true"><bh-icono nombre="libro" clase="size-8 opacity-70" /></div>
                            <div class="min-w-0 flex-1 space-y-2">
                                <p class="font-display text-xl leading-tight">@linea.Titulo</p>
                                <p class="text-sm opacity-80">@linea.FormatoTexto@(linea.Isbn is null ? string.Empty : " · ISBN " + linea.Isbn)</p>
                                @if (linea.Sucursal is not null)
                                {
                                    <p class="flex items-center gap-1 text-sm"><bh-icono nombre="sucursal" clase="size-4" /><span>Lo atiende <strong>@linea.Sucursal</strong></span></p>
                                }
                                <div class="flex flex-wrap items-center gap-2">
                                    @if (linea.Retirada)
                                    {
                                        <span class="badge badge-warning h-auto gap-1 py-1 font-semibold"><bh-icono nombre="aviso" clase="size-4" /><span>Retirada del catálogo</span></span>
                                    }
                                    else if (linea.Disponibilidad is not null)
                                    {
                                        <vc:bh-disponibilidad modelo="@linea.Disponibilidad" />
                                    }
                                    @if (linea.NotaDeFrescura is not null)
                                    {
                                        <span class="text-xs opacity-80">@linea.NotaDeFrescura</span>
                                    }
                                </div>
                                @if (linea.Retirada)
                                {
                                    <p class="text-sm" role="status">Esta edición se retiró del catálogo: se quitará de tu carrito al terminar tu compra en curso.</p>
                                }
                                else if (linea.Disponibilidad?.Estado == EstadoDeDisponibilidad.Agotado)
                                {
                                    <p class="text-sm" role="status">Ya no hay unidades en @(linea.Sucursal ?? "su sucursal"): quita este libro para continuar con la compra.</p>
                                }
                                @if (linea.SinSucursal)
                                {
                                    <p class="flex gap-2 text-sm" role="status"><bh-icono nombre="aviso" clase="size-5 shrink-0" />Agregaste este libro antes de la venta por sucursal: quítalo y vuelve a agregarlo desde su ficha eligiendo la sucursal.</p>
                                }
                                <bh-accion-de-cambio>
                                    <div class="flex flex-wrap items-end gap-3 pt-1">
                                        @if (linea.EsDigital)
                                        {
                                            <p class="text-sm">Una licencia por cuenta.</p>
                                        }
                                        else if (!linea.Retirada && !linea.SinSucursal)
                                        {
                                            var ayuda = "ayuda-" + linea.LineaId.ToString("N");
                                            <form method="post" action="/carrito/lineas/@linea.LineaId.ToString("D")" class="flex flex-wrap items-end gap-2" data-bh-cantidad="@linea.LineaId.ToString("D")">
                                                <partial name="_TokenAntifalsificacion" />
                                                <label class="flex flex-col gap-1 text-sm">
                                                    <span>Cantidad de @etiqueta@(linea.Sucursal is null ? string.Empty : " en " + linea.Sucursal)</span>
                                                    <input class="input input-sm w-24" type="number" name="cantidad" value="@linea.Cantidad" min="1" max="@linea.CantidadMaxima" inputmode="numeric" required aria-describedby="@ayuda" />
                                                </label>
                                                <p id="@ayuda" class="pb-1 text-xs opacity-80">Se actualiza al cambiar la cantidad.</p>
                                                <noscript><button type="submit" class="btn btn-sm">Actualizar</button></noscript>
                                            </form>
                                        }
                                        <form method="post" action="/carrito/lineas/@linea.LineaId.ToString("D")/quitar">
                                            <partial name="_TokenAntifalsificacion" />
                                            <button type="submit" class="btn btn-ghost btn-sm" aria-label="Quitar @etiqueta@(linea.Sucursal is null ? string.Empty : " de " + linea.Sucursal) del carrito">Quitar</button>
                                        </form>
                                    </div>
                                </bh-accion-de-cambio>
                            </div>
                        </div>
                        <div class="text-right sm:w-36">
                            <p class="font-display text-xl">@linea.ImporteTexto</p>
                            <p class="text-sm opacity-80">@(Model.PreciosNoConfirmados ? "Cantidad: " + linea.Cantidad : linea.Cantidad + " × " + linea.PrecioTexto)</p>
                        </div>
                    </li>
                }
            </ul>
        </section>

        <aside class="space-y-3 rounded-box border border-base-300 bg-base-100 p-5 lg:sticky lg:top-28" aria-label="Resumen de tu compra">
            <h2 class="font-display text-2xl">Resumen</h2>
            <div class="flex justify-between"><span>Subtotal</span><span>@Model.SubtotalTexto</span></div>
            <div class="flex justify-between text-sm opacity-80"><span>Envío</span><span>@(Model.HayImpresos ? "Se elige en el siguiente paso" : "No aplica (solo digitales)")</span></div>
            @if (Model.HayImpresos)
            {
                <p class="text-xs opacity-80">Recojo gratis en la sucursal de cada libro; a domicilio, cada sucursal cobra su envío.</p>
            }
            <div class="flex justify-between border-t border-base-300 pt-3 font-display text-xl"><span>Total</span><span>@Model.SubtotalTexto</span></div>
            @if (Model.HayImpresos)
            {
                <p class="flex gap-2 text-xs opacity-80"><bh-icono nombre="reloj" clase="size-4 shrink-0" />Reservamos tus libros impresos durante 15 minutos cuando inicias el pago.</p>
            }
            @if (Model.HayDigitales)
            {
                <p class="flex gap-2 text-xs opacity-80"><bh-icono nombre="candado" clase="size-4 shrink-0" />Los libros digitales aparecen en tu biblioteca cuando se aprueba el pago.</p>
            }

            @if (Model.HayProblema)
            {
                <p class="flex gap-2 text-sm" role="status"><bh-icono nombre="aviso" clase="size-5 shrink-0" />Resuelve los avisos de arriba para continuar con la compra.</p>
                <span class="btn btn-primary btn-disabled w-full" aria-disabled="true">Continuar con la compra</span>
            }
            else if (!Model.HaySesion)
            {
                <p class="text-sm">Para pagar necesitas una cuenta. Tu carrito se conserva al ingresar.</p>
                <a class="btn btn-primary w-full" href="@BabelHub.Ecommerce.Api.Web.ContinuacionDelIngreso.RutaDelIngresoDeLaCompra">Ingresar para continuar</a>
            }
            else if (Model.HayCompraEnCurso)
            {
                <a class="btn btn-primary w-full" href="/checkout">Volver a mi compra</a>
            }
            else
            {
                <bh-accion-de-cambio>
                    <form method="post" action="/checkout/iniciar">
                        <partial name="_TokenAntifalsificacion" />
                        <button type="submit" class="btn btn-primary w-full">Continuar con la compra</button>
                    </form>
                </bh-accion-de-cambio>
            }
            <a class="btn btn-ghost btn-sm w-full" href="/catalogo">Seguir comprando</a>
        </aside>
    </div>
}
