@using BabelHub.Ecommerce.Application.Carrito
@model BabelHub.Ecommerce.Api.Areas.Tienda.Controllers.CheckoutVista
@{
    var checkout = Model.Checkout;
    var enEdicion = checkout.Estado == EstadoVisibleDelCheckout.EnEdicion;
    var tipo = checkout.TipoDeEntrega;
    var pedido = checkout.PedidoId?.ToString("D");
    var sucursalElegida = checkout.CodigoDeSucursalDeRecojo ?? Model.SucursalPreferida;
    var contacto = checkout.Contacto;
    string Campo(string nombre, string? guardado) => Model.Valores.ContainsKey(nombre) ? Model.Valor(nombre) : guardado ?? string.Empty;
}
<h1 class="font-display text-4xl leading-tight sm:text-5xl">Finalizar compra</h1>
<vc:bh-aviso-de-pagos-simulados en-contexto="true" />
<vc:bh-aviso-de-envios-simulados en-contexto="true" />

<ol class="steps my-6 w-full text-xs sm:text-sm" aria-label="Progreso de la compra">
    @foreach (var paso in Model.Pasos)
    {
        <li class="step @(paso.Actual || paso.Hecho ? "step-primary" : string.Empty)" aria-current="@(paso.Actual ? "step" : null)">@paso.Nombre@(paso.Hecho ? " (listo)" : string.Empty)</li>
    }
</ol>

@if (Model.AlertaTitulo is not null)
{
    <div class="alert alert-warning alert-vertical sm:alert-horizontal mb-6" role="alert" tabindex="-1" id="aviso-del-checkout" data-bh-foco-inicial>
        <bh-icono nombre="aviso" />
        <div>
            <h2 class="font-semibold">@Model.AlertaTitulo</h2>
            <p>@Model.AlertaMensaje</p>
        </div>
    </div>
}

@if (checkout.CarritoCambio)
{
    <div class="alert alert-info mb-6" role="status">
        <bh-icono nombre="info" />
        <span>Tu carrito cambió: revisa tu compra antes de pagar. No se hizo ningún cobro.</span>
    </div>
}

@if (Model.StockNoValidable)
{
    <div class="alert alert-error alert-vertical sm:alert-horizontal mb-6" role="alert">
        <bh-icono nombre="error" />
        <div>
            <h2 class="font-semibold">No podemos validar el stock de los impresos ahora</h2>
            <p>Por seguridad no cobraremos nada hasta poder confirmarlo. Tu carrito sigue guardado.</p>
        </div>
        <a class="btn btn-sm" href="/checkout"><bh-icono nombre="reintentar" clase="size-4" />Reintentar</a>
    </div>
}

<div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[1fr_21rem]">
    <div class="min-w-0 space-y-8">
        <section aria-labelledby="titulo-revision">
            <h2 id="titulo-revision" class="font-display text-2xl">Revisa tus libros</h2>
            <ul class="mt-3 divide-y divide-base-300 rounded-box border border-base-300 bg-base-100">
                @foreach (var linea in Model.Lineas)
                {
                    <li class="flex flex-col gap-2 p-4 sm:flex-row sm:items-center sm:justify-between">
                        <div class="min-w-0 space-y-1">
                            <p class="font-medium">@linea.Titulo</p>
                            <p class="text-sm opacity-80">@linea.FormatoTexto · @linea.Cantidad × @linea.PrecioTexto</p>
                            <div class="flex flex-wrap items-center gap-2">
                                <vc:bh-disponibilidad modelo="@linea.Disponibilidad" />
                                @if (linea.Plazo is not null)
                                {
                                    <span class="text-sm">@linea.Plazo</span>
                                }
                            </div>
                            @if (linea.Retirada)
                            {
                                <p class="text-sm" role="status">Esta edición se retiró del catálogo: se quitará de tu carrito.</p>
                            }
                        </div>
                        <p class="font-display text-xl sm:text-right">@linea.ImporteTexto</p>
                    </li>
                }
            </ul>
            @if (Model.HayProblema)
            {
                <p class="mt-3 flex gap-2 text-sm" role="status"><bh-icono nombre="aviso" clase="size-5 shrink-0" />Alguna línea ya no se puede comprar. Vuelve al carrito para corregirla: no perderás las demás.</p>
            }
        </section>

        @if (Model.RequiereEntrega && enEdicion)
        {
            <section aria-labelledby="titulo-entrega">
                <h2 id="titulo-entrega" class="font-display text-2xl">¿Cómo quieres recibir tus impresos?</h2>
                @if (Model.HayDigitales)
                {
                    <p class="mt-1 text-sm opacity-80">Tus libros digitales no necesitan entrega: estarán en tu biblioteca.</p>
                }
                <div class="mt-3 grid gap-4 md:grid-cols-2">
                    <form method="post" action="/checkout/entrega" class="space-y-3 rounded-box border @(tipo == TipoDeEntregaDeCompra.Recojo ? "border-primary" : "border-base-300") bg-base-100 p-4" novalidate>
                        <partial name="_TokenAntifalsificacion" />
                        <input type="hidden" name="tipoDeEntrega" value="recojo" />
                        @if (pedido is not null) { <input type="hidden" name="pedidoId" value="@pedido" /> }
                        <h3 class="flex items-center gap-2 font-semibold">Recojo en sucursal @if (tipo == TipoDeEntregaDeCompra.Recojo) { <span class="badge badge-primary">Elegido</span> }</h3>
                        <p class="text-sm opacity-80">Gratis · te avisamos cuando esté listo.</p>
                        @if (Model.SucursalesDeRecojo.Count == 0)
                        {
                            <p class="text-sm" role="status">No pudimos cargar las sucursales ahora. <a class="link" href="/checkout">Reintentar</a></p>
                        }
                        else
                        {
                            <label class="flex flex-col gap-1 text-sm">
                                <span>Sucursal de recojo</span>
                                <select name="sucursal" class="select w-full" aria-invalid="@(Model.Error("sucursal") is null ? "false" : "true")" aria-describedby="@(Model.Error("sucursal") is null ? null : "error-sucursal")">
                                    @foreach (var s in Model.SucursalesDeRecojo)
                                    {
                                        <option value="@s.Codigo" selected="@(s.Codigo == (Model.Valor("sucursal") is { Length: > 0 } v ? v : sucursalElegida))">@s.Nombre</option>
                                    }
                                </select>
                            </label>
                            @if (Model.Error("sucursal") is { } errorSucursal)
                            {
                                <p id="error-sucursal" class="text-sm text-error">@errorSucursal</p>
                            }
                            <bh-accion-de-cambio><button type="submit" class="btn btn-primary btn-sm">Elegir recojo</button></bh-accion-de-cambio>
                        }
                    </form>

                    <form method="post" action="/checkout/entrega" class="space-y-3 rounded-box border @(tipo == TipoDeEntregaDeCompra.Domicilio ? "border-primary" : "border-base-300") bg-base-100 p-4" novalidate>
                        <partial name="_TokenAntifalsificacion" />
                        <input type="hidden" name="tipoDeEntrega" value="domicilio" />
                        @if (pedido is not null) { <input type="hidden" name="pedidoId" value="@pedido" /> }
                        <h3 class="flex items-center gap-2 font-semibold">Despacho a domicilio @if (tipo == TipoDeEntregaDeCompra.Domicilio) { <span class="badge badge-primary">Elegido</span> }</h3>
                        <p class="text-sm opacity-80">Con guía de envío. El costo se suma al total.</p>
                        @{
                            var campos = new (string Nombre, string Etiqueta, string Tipo, string Autocompletar, string? Ayuda, string Valor)[]
                            {
                                ("nombre", "Nombre completo", "text", "name", null, Campo("nombre", contacto?.Nombre)),
                                ("telefono", "Celular de contacto", "tel", "tel-national", "9 dígitos, por ejemplo 987654321", Campo("telefono", contacto?.Telefono)),
                                ("direccion", "Dirección de entrega", "text", "street-address", null, Campo("direccion", contacto?.Direccion)),
                                ("region", "Región", "text", "address-level1", "Por ejemplo: ayacucho", Campo("region", contacto?.Region ?? checkout.RegionDeEntrega)),
                            };
                        }
                        @foreach (var c in campos)
                        {
                            var error = Model.Error(c.Nombre);
                            <label class="flex flex-col gap-1 text-sm" for="entrega-@c.Nombre">
                                <span>@c.Etiqueta</span>
                                <input id="entrega-@c.Nombre" class="input w-full @(error is null ? string.Empty : "input-error")" type="@c.Tipo" name="@c.Nombre" value="@c.Valor" autocomplete="@c.Autocompletar" inputmode="@(c.Tipo == "tel" ? "tel" : null)" aria-invalid="@(error is null ? "false" : "true")" aria-describedby="@(error is not null ? "error-" + c.Nombre : c.Ayuda is not null ? "ayuda-" + c.Nombre : null)" />
                            </label>
                            @if (error is not null)
                            {
                                <p id="error-@c.Nombre" class="-mt-2 text-sm text-error">@error</p>
                            }
                            else if (c.Ayuda is not null)
                            {
                                <p id="ayuda-@c.Nombre" class="-mt-2 text-xs opacity-80">@c.Ayuda</p>
                            }
                        }
                        <bh-accion-de-cambio><button type="submit" class="btn btn-primary btn-sm">Elegir domicilio</button></bh-accion-de-cambio>
                    </form>
                </div>
            </section>
        }
        else if (!Model.RequiereEntrega)
        {
            <p class="flex gap-2 text-sm opacity-80"><bh-icono nombre="candado" clase="size-5 shrink-0" />Compra 100 % digital: sin entrega. Tus libros aparecen en tu biblioteca cuando se aprueba el pago.</p>
        }

        @if (enEdicion && (tipo is not null || !Model.RequiereEntrega))
        {
            var bloqueado = Model.HayProblema || Model.StockNoValidable || Model.Textos.Count == 0;
            var consentimiento = checkout.ConsentimientoDeWhatsApp;
            <section aria-labelledby="titulo-datos">
                <h2 id="titulo-datos" class="font-display text-2xl">Tus datos y aceptaciones</h2>
                @if (tipo == TipoDeEntregaDeCompra.Recojo)
                {
                    <p class="mt-1 text-sm opacity-80">Recogerás tus impresos en la sucursal que elegiste. Te avisamos cuando estén listos.</p>
                }
                else if (tipo == TipoDeEntregaDeCompra.Domicilio)
                {
                    <p class="mt-1 text-sm opacity-80">Despacharemos tus impresos a la dirección que indicaste.</p>
                }

                @if (Model.Textos.Count == 0)
                {
                    <div class="alert alert-warning mt-3" role="status">
                        <bh-icono nombre="aviso" />
                        <span>No podemos mostrar los textos legales ahora, así que todavía no se puede pagar. Tu carrito sigue guardado.</span>
                        <a class="btn btn-sm" href="/checkout"><bh-icono nombre="reintentar" clase="size-4" />Reintentar</a>
                    </div>
                }

                <form method="post" action="/checkout" class="mt-3 space-y-4" novalidate>
                    <partial name="_TokenAntifalsificacion" />
                    <input type="hidden" name="totalVisto" value="@Model.TotalVisto" />
                    @if (pedido is not null) { <input type="hidden" name="pedidoId" value="@pedido" /> }

                    <fieldset class="space-y-3">
                        <legend class="font-semibold">Para continuar, acepta:</legend>
                        @foreach (var texto in Model.Textos)
                        {
                            var error = Model.Error(texto.Campo);
                            <div>
                                <label class="flex cursor-pointer items-start gap-3">
                                    <input type="checkbox" class="checkbox checkbox-primary mt-0.5" name="@texto.Campo" value="@texto.Version" checked="@(texto.Aceptado || Model.Valores.ContainsKey(texto.Campo))" aria-invalid="@(error is null ? "false" : "true")" aria-describedby="@(error is null ? null : "error-" + texto.Campo)" />
                                    <span class="text-sm">Acepto @texto.Titulo. <a class="link" href="@texto.Ruta" target="_blank" rel="noopener">Leer (se abre en otra pestaña)</a></span>
                                </label>
                                @if (error is not null)
                                {
                                    <p id="error-@texto.Campo" class="ml-8 mt-1 text-sm text-error">Para pagar necesitas aceptar este texto.</p>
                                }
                            </div>
                        }
                    </fieldset>

                    @if (consentimiento is { Estado: EstadoDelConsentimientoDeCompra.SeOfrece })
                    {
                        <div>
                            <label class="flex cursor-pointer items-start gap-3">
                                <input type="checkbox" class="checkbox checkbox-primary mt-0.5" name="consentimientoDeWhatsApp" value="true" checked="@(Model.Valor("consentimientoDeWhatsApp") == "true")" />
                                <span class="text-sm">Quiero recibir avisos de mi pedido por WhatsApp al número @consentimiento.HuellaEnmascarada (opcional; puedes cambiarlo en tu cuenta).</span>
                            </label>
                            <input type="hidden" name="huellaDelNumero" value="@consentimiento.HuellaEnmascarada" />
                        </div>
                    }
                    else if (consentimiento is { Estado: EstadoDelConsentimientoDeCompra.YaConsiente })
                    {
                        <p class="flex gap-2 text-sm"><bh-icono nombre="exito" clase="size-5 shrink-0" />Ya recibes avisos de tus pedidos por WhatsApp.</p>
                    }
                    else if (consentimiento is { Estado: EstadoDelConsentimientoDeCompra.NoGuardado })
                    {
                        <p class="flex gap-2 text-sm" role="status"><bh-icono nombre="aviso" clase="size-5 shrink-0" />No pudimos guardar tu preferencia de WhatsApp. Tu compra sigue: puedes cambiarla en tu cuenta.</p>
                    }

                    <verificacion-de-persona />

                    @if (bloqueado)
                    {
                        <p class="flex gap-2 text-sm" role="status"><bh-icono nombre="aviso" clase="size-5 shrink-0" />@(Model.Textos.Count == 0 ? "Hasta poder mostrar los textos legales no se puede pagar." : "Resuelve los avisos de arriba para pasar al pago.")</p>
                    }

                    <bh-accion-de-cambio>
                        <button type="submit" class="btn btn-primary" disabled="@bloqueado" aria-disabled="@(bloqueado ? "true" : null)">Ir al pago · @Model.TotalTexto</button>
                    </bh-accion-de-cambio>
                    <p class="text-xs opacity-80">Reservamos tus impresos durante 15 minutos cuando pasas al pago. No se cobra nada hasta que confirmes el pago.</p>
                </form>
            </section>
        }

        @if (!enEdicion)
        {
            <section class="rounded-box border border-base-300 bg-base-100 p-4" role="status" aria-label="Estado de tu compra">
                <p class="font-semibold">@(checkout.Estado == EstadoVisibleDelCheckout.PagoPendiente ? "Tu pago está en proceso" : checkout.Estado == EstadoVisibleDelCheckout.EnPago ? "Tu compra está lista para pagar" : "Estamos preparando tu compra")</p>
                @if (checkout.PedidoId is not null)
                {
                    <a class="btn btn-primary mt-3" href="@(checkout.Estado == EstadoVisibleDelCheckout.PagoPendiente ? "/checkout/pago/estado" : "/checkout/pago")">Ir al pago</a>
                }
            </section>
        }

        @if (checkout.Estado is EstadoVisibleDelCheckout.EnEdicion or EstadoVisibleDelCheckout.EnPago)
        {
            <bh-accion-de-cambio>
                <form method="post" action="/checkout/volver">
                    <partial name="_TokenAntifalsificacion" />
                    @if (pedido is not null) { <input type="hidden" name="pedidoId" value="@pedido" /> }
                    <button type="submit" class="btn btn-ghost btn-sm">Volver al carrito</button>
                </form>
            </bh-accion-de-cambio>
        }
    </div>

    <aside class="rounded-box border border-base-300 bg-base-100 p-5 lg:sticky lg:top-28" aria-label="Resumen de tu pedido">
        <h2 class="mb-2 font-display text-2xl">Tu pedido</h2>
        <ul class="space-y-1.5 text-sm">
            @foreach (var linea in Model.Lineas)
            {
                <li class="flex justify-between gap-2"><span class="truncate">@linea.Cantidad × @linea.Titulo <span class="opacity-70">(@(linea.FormatoTexto == "Libro digital" ? "digital" : "impreso"))</span></span><span>@linea.ImporteTexto</span></li>
            }
        </ul>
        <dl class="mt-3 space-y-1 border-t border-base-300 pt-3 text-sm">
            <div class="flex justify-between"><dt>Subtotal</dt><dd>@Model.SubtotalTexto</dd></div>
            <div class="flex justify-between"><dt>Envío</dt><dd>@Model.EnvioTexto</dd></div>
            <div class="flex justify-between pt-1 font-display text-xl"><dt>Total</dt><dd>@Model.TotalTexto</dd></div>
        </dl>
        <p class="mt-3 text-xs opacity-80">@(Model.HayDigitales && !Model.HayImpresos ? "Compra 100 % digital: sin entrega." : Model.HayDigitales ? "Un solo cobro por impresos y digitales." : "Reservamos tus impresos 15 minutos cuando inicias el pago.")</p>
    </aside>
</div>
