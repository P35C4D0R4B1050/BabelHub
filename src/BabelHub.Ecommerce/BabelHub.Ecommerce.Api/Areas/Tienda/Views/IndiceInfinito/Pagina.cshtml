@using BabelHub.Ecommerce.Api.Areas.Tienda.Controllers
@model IndiceInfinitoVista
<section class="bh-laberinto rounded-box bg-base-200 px-4 py-8 sm:px-8 sm:py-10">
    <p class="text-sm font-semibold uppercase tracking-wider text-accent">Experimento literario</p>
    <h1 class="bh-display mt-3">El índice infinito</h1>
    <p class="mt-3 max-w-2xl">Inspirado en <i>La biblioteca de Babel</i>, de Borges. Cada dirección genera siempre la misma página de texto al azar. El texto se calcula con un algoritmo y no se guarda en ninguna parte.</p>

    <div class="alert alert-info mt-6" role="note">
        <bh-icono nombre="info" />
        <span><strong>Texto generado.</strong> Puede carecer de sentido y no son libros reales ni están a la venta.</span>
    </div>

    @if (Model.DireccionNoValida)
    {
        <div class="alert alert-warning mt-4" role="status" data-bh-foco-inicial tabindex="-1">
            <bh-icono nombre="aviso" />
            <div>
                <h2 class="font-semibold">Esa dirección no existe en este laberinto</h2>
                <p>Usa de 1 a 64 letras minúsculas sin tilde, números o guiones. Mientras tanto, te mostramos una página al azar.</p>
            </div>
        </div>
    }

    <div class="mt-8 border border-base-300 bg-base-100">
        <div class="flex flex-wrap items-center gap-2 border-b border-base-300 p-3 text-sm">
            <label class="flex w-full min-w-0 items-center gap-2 sm:w-auto sm:flex-1" for="direccion-de-la-pagina">
                <span>Dirección</span>
                <input id="direccion-de-la-pagina" class="input input-sm min-w-0 flex-1 font-mono" type="text" readonly value="@Model.Direccion" />
            </label>
            <a class="btn btn-sm btn-primary" href="@Model.RutaDeOtraAlAzar" rel="nofollow">Otra página al azar</a>
            <button type="button" class="btn btn-sm btn-outline" id="copiar-enlace" data-ruta="@Model.RutaCanonica" hidden>Copiar enlace</button>
        </div>
        <p id="aviso-de-copia" class="px-3 pt-2 text-sm" role="status"></p>
        <div role="region" aria-label="Página generada">
            <pre lang="es" tabindex="0" class="whitespace-pre-wrap break-all p-4 font-mono text-xs leading-relaxed sm:text-sm">@Model.Texto</pre>
        </div>
    </div>

    <form method="get" action="/indice-infinito" class="mt-6 flex flex-wrap items-end gap-2">
        <label class="flex min-w-[14rem] flex-1 flex-col gap-1" for="ir-a-una-direccion">
            <span>Ir a una dirección</span>
            <input id="ir-a-una-direccion" name="direccion" class="input w-full font-mono" type="text" maxlength="64" autocomplete="off" placeholder="s12-p3-e4-v5-pg100" />
        </label>
        <button class="btn btn-outline" type="submit">Ir</button>
    </form>

    <p class="mt-8 text-sm">¿Prefieres libros que sí existen? <a class="link font-semibold" href="/catalogo">Vuelve al catálogo de BabelHub</a>.</p>
</section>

@section Scripts {
    <script src="/js/indice-infinito.js" defer></script>
}
