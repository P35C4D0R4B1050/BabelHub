@using BabelHub.Ecommerce.Api.Controllers
@using BabelHub.Ecommerce.Application.Web
@using BabelHub.Ecommerce.Api.Web.Formato
@model AceptarTextosVista
<section class="mx-auto max-w-2xl" aria-labelledby="titulo-aceptar">
    <h1 id="titulo-aceptar" class="font-display text-4xl">Actualizamos nuestros textos legales</h1>
    <p class="mt-3 text-lg">Para seguir usando BabelHub, lee y acepta la versión vigente de nuestros términos, la política de privacidad y la de reembolso.</p>
    @if (Model.LaVersionCambio)
    {
        <div class="alert alert-warning mt-4" role="status">
            <bh-icono nombre="aviso" />
            <span>Los textos cambiaron mientras los leías. Revisa las versiones de abajo y vuelve a aceptar.</span>
        </div>
    }
    <ul class="mt-6 space-y-3">
        @foreach (var texto in Model.Version.Textos)
        {
            <li class="rounded-box border border-base-300 p-4">
                <a class="link font-semibold" href="/legal/@TiposDeTextoLegal.Clave(texto.Tipo)">@texto.Titulo</a>
                <p class="mt-1 text-sm">Versión <strong>@texto.Version</strong> · Vigente desde <time datetime="@texto.VigenteDesde.ToString("yyyy-MM-dd")">@FormatoPeruano.Fecha(texto.VigenteDesde)</time></p>
                @if (texto.Provisional)
                {
                    <p class="mt-1 text-sm"><strong>Texto provisional.</strong> Pendiente de la revisión legal definitiva.</p>
                }
            </li>
        }
    </ul>
    <form method="post" action="/textos/aceptar" asp-antiforgery="true" class="mt-6">
        <input type="hidden" name="version" value="@Model.Version.Identificador" />
        <button type="submit" class="btn btn-primary">Acepto los textos legales</button>
    </form>
</section>
