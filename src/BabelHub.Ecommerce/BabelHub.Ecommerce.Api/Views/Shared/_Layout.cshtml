@model ModeloBaseDePagina
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
@* Sin elección de la persona no se escribe data-theme (Razor emitiría data-theme=""): así manda la preferencia del dispositivo (WEB-09). *@
@if (Model.Tema is { } tema)
{
    @:<html lang="es-PE" data-theme="@tema">
}
else
{
    @:<html lang="es-PE">
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@Model.Titulo · BabelHub</title>
    <meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"historyCacheSize":0,"selfRequestsOnly":true,"includeIndicatorStyles":false}' />
    @* El token antifalsificación para htmx (WEB-05): bh.js lo envía en la cabecera de cada solicitud, sin scripts en línea. *@
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="stylesheet" href="/css/app.css" />
    <script src="/lib/htmx/htmx.min.js" defer></script>
    <script src="/js/bh.js" defer></script>
</head>
<body class="min-h-screen flex flex-col bg-base-100 text-base-content">
    <a class="bh-saltar" href="#contenido">Saltar al contenido</a>
    @await Html.PartialAsync("_Cabecera", Model)
    <main id="contenido" tabindex="-1" class="mx-auto w-full max-w-7xl flex-1 px-4 py-6">
        @if (Model.TextosPendientes)
        {
            <div class="alert alert-warning mb-6" role="status">
                <bh-icono nombre="aviso" />
                <span>Actualizamos nuestros términos. Acéptalos para pagar; puedes seguir viendo tu cuenta y tus pedidos.</span>
                <a class="btn btn-sm" href="/textos/aceptar">Revisar y aceptar</a>
            </div>
        }
        @RenderBody()
    </main>
    @* PAG-33: con la pasarela simulada, el aviso va justo encima del pie de toda página (no dibuja nada con la pasarela real). *@
    <vc:bh-aviso-de-pagos-simulados />
    @* PAG-42: con el operador logístico simulado (no habrá uno real), la tienda lo dice con honestidad, también en producción. *@
    <vc:bh-aviso-de-envios-simulados />
    @await Html.PartialAsync("_Pie", Model)
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
