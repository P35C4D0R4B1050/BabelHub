using System.Globalization;
using System.Net;
using System.Text;
using System.Text.Json;
using System.Text.Json.Serialization;
using System.Text.RegularExpressions;
using BabelHub.Ecommerce.Application.Plataforma;
using BabelHub.Shared.Contratos;
using BabelHub.Shared.Contratos.Inventario;
using BabelHub.Shared.Errores;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.DependencyInjection.Extensions;
using Microsoft.Extensions.Http;

namespace BabelHub.Ecommerce.Infrastructure.Plataforma;

/// <summary>
/// <see cref="IClienteDelInventario"/> sobre HTTP: traduce entre los modelos propios del puerto y los DTO de <c>BabelHub.Shared</c> (contratos v1 congelados en ECO-0) y llama con el alcance de cada operación
/// (<see cref="OpcionesDeLaSolicitudDeServicio"/>); los manejadores de salida ponen la credencial de servicio y, en las operaciones de usuario, el token verificable de la persona (nunca una cabecera de actor). Los
/// reintentos y el cortacircuitos son los de <see cref="ClientesHttpDeServicio"/> (SEG-14): solo se reintentan las lecturas, los <c>PUT</c> y los <c>POST</c> con clave de idempotencia.
/// </summary>
/// <remarks>
/// <b>Una falla del Inventario nunca es una excepción</b>: un corte, un 5xx, un plazo vencido, un cortacircuitos abierto, una respuesta demasiado grande, que no es JSON o con valores que el contrato no admite son
/// <see cref="EstadoDeLlamadaAlInventario.NoDisponible"/>; un 429 es <see cref="EstadoDeLlamadaAlInventario.LimiteExcedido"/> y un 400, 401, 403, 404, 409 o 422, <see cref="EstadoDeLlamadaAlInventario.Rechazada"/> con
/// el <c>code</c> estable del problema. Nunca se registra el cuerpo, el token ni el texto del error remoto, y cada respuesta se valida contra lo que se pidió (un ingreso de otra edición no es una respuesta válida).
/// </remarks>
public sealed class HttpClienteDelInventario(IHttpClientFactory fabrica) : IClienteDelInventario
{
    /// <summary>El cliente con nombre del Inventario: el mismo al que la Api le agrega el manejador del token de la sesión (<c>TokenDelUsuarioDeLaSesionExtensiones.ClienteDelInventario</c>; una prueba lo vigila).</summary>
    public const string NombreDelCliente = "inventario";

    public const int MaximoDeBytesDeLaRespuesta = 1_048_576;

    private const int MaximoDeBytesDelProblema = 16_384;

    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web) { NumberHandling = JsonNumberHandling.Strict, AllowTrailingCommas = false };

    private static readonly Regex CodigoDeError = new("^(INV|ECO)-[A-Z0-9]+(-[A-Z0-9]+)*$", RegexOptions.CultureInvariant | RegexOptions.NonBacktracking, TimeSpan.FromMilliseconds(100));

    private static readonly Regex ClaveValida = new("^[A-Za-z0-9_-]{16,80}$", RegexOptions.CultureInvariant | RegexOptions.NonBacktracking, TimeSpan.FromMilliseconds(100));

    public async Task<ResultadoDelInventario> RegistrarEdicion(EdicionARegistrar edicion, CancellationToken cancelacion = default)
    {
        ArgumentNullException.ThrowIfNull(edicion);
        if (edicion.EdicionId == Guid.Empty || !FormatosDeEdicion.Todos.Contains(edicion.Formato))
        {
            throw new ArgumentException("La edición necesita un identificador y un formato del contrato (impreso o digital).", nameof(edicion));
        }

        var cuerpo = JsonSerializer.Serialize(new RegistrarEdicionDto(edicion.Formato), Json);
        var resultado = await Pedir(
            HttpMethod.Put,
            $"{RutasDeServicio.Inventario}/ediciones/{edicion.EdicionId:D}",
            AlcanceDeServicio.OperacionDeUsuario,
            cuerpo,
            claveDeIdempotencia: null,
            conOrigen: false,
            _ => true,
            cancelacion,
            HttpStatusCode.NoContent).ConfigureAwait(false);
        return resultado.Exitosa ? ResultadoDelInventario.Correcta : ComoSinValor(resultado);
    }

    public Task<ResultadoDelInventario<DisponibilidadDeVariasEdiciones>> ConsultarDisponibilidad(IReadOnlyList<Guid> edicionIds, CancellationToken cancelacion = default)
    {
        ArgumentNullException.ThrowIfNull(edicionIds);
        if (edicionIds.Count is 0 or > LimitesDeContrato.MaximoDeEdicionesPorConsulta || edicionIds.Any(id => id == Guid.Empty) || edicionIds.Distinct().Count() != edicionIds.Count)
        {
            throw new ArgumentException($"La consulta lleva de 1 a {LimitesDeContrato.MaximoDeEdicionesPorConsulta} ediciones distintas.", nameof(edicionIds));
        }

        var cuerpo = JsonSerializer.Serialize(new ConsultaDeDisponibilidadDto([.. edicionIds]), Json);
        var pedidas = edicionIds.ToHashSet();
        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/disponibilidad/consultas",
            AlcanceDeServicio.LecturaDeDisponibilidad,
            cuerpo,
            claveDeIdempotencia: null,
            conOrigen: true,
            texto => ADisponibilidad(texto, pedidas),
            cancelacion);
    }

    public Task<ResultadoDelInventario<IngresoRegistrado>> RegistrarIngreso(IngresoARegistrar ingreso, string claveDeIdempotencia, CancellationToken cancelacion = default)
    {
        ArgumentNullException.ThrowIfNull(ingreso);
        if (ingreso.EdicionId == Guid.Empty || ingreso.Cantidad is < LimitesDeContrato.IngresoMinimo or > LimitesDeContrato.IngresoMaximo)
        {
            throw new ArgumentException("El ingreso necesita una edición y una cantidad entre los límites del contrato.", nameof(ingreso));
        }

        if (string.IsNullOrEmpty(claveDeIdempotencia) || !ClaveValida.IsMatch(claveDeIdempotencia))
        {
            throw new ArgumentException("La clave de idempotencia tiene de 16 a 80 caracteres de [A-Za-z0-9_-].", nameof(claveDeIdempotencia));
        }

        var cuerpo = JsonSerializer.Serialize(new RegistrarIngresoDto(ingreso.EdicionId, ingreso.CodigoDeFuente, ingreso.Cantidad, ingreso.Referencia, ingreso.Nota), Json);
        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/ingresos-de-mercaderia",
            AlcanceDeServicio.OperacionDeUsuario,
            cuerpo,
            claveDeIdempotencia,
            conOrigen: false,
            texto =>
            {
                var dto = JsonSerializer.Deserialize<IngresoDeMercaderiaDto>(texto, Json) ?? throw new JsonException("La respuesta no es un ingreso.");
                var registrado = AIngreso(dto);
                return registrado.EdicionId == ingreso.EdicionId && registrado.Cantidad == ingreso.Cantidad
                    ? registrado
                    : throw new JsonException("El ingreso devuelto no es el pedido.");
            },
            cancelacion,
            HttpStatusCode.Created);
    }

    public Task<ResultadoDelInventario<IReadOnlyList<IngresoRegistrado>>> ListarIngresos(Guid edicionId, int limite, CancellationToken cancelacion = default)
    {
        if (edicionId == Guid.Empty || limite is < 1 or > 50)
        {
            throw new ArgumentException("La consulta necesita una edición y un límite de 1 a 50.");
        }

        return Pedir<IReadOnlyList<IngresoRegistrado>>(
            HttpMethod.Get,
            $"{RutasDeServicio.Inventario}/ingresos-de-mercaderia?edicionId={edicionId:D}&limite={limite.ToString(CultureInfo.InvariantCulture)}",
            AlcanceDeServicio.OperacionDeUsuario,
            cuerpo: null,
            claveDeIdempotencia: null,
            conOrigen: false,
            texto =>
            {
                var lista = JsonSerializer.Deserialize<ListaDeIngresosDto>(texto, Json) ?? throw new JsonException("La respuesta no es una lista de ingresos.");
                var ingresos = (lista.Ingresos ?? throw new JsonException("Faltan los ingresos.")).Select(AIngreso).ToList();
                return ingresos.Count <= limite && ingresos.All(i => i.EdicionId == edicionId)
                    ? ingresos
                    : throw new JsonException("La lista trae más de lo pedido o ingresos de otra edición.");
            },
            cancelacion);
    }

    public Task<ResultadoDelInventario<PendientesDeTitular>> ConsultarPendientes(Guid titularId, CancellationToken cancelacion = default)
    {
        if (titularId == Guid.Empty)
        {
            throw new ArgumentException("La consulta necesita el identificador del titular.", nameof(titularId));
        }

        var cuerpo = JsonSerializer.Serialize(new ConsultaDePendientesDto(titularId), Json);
        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/titulares/consultas-de-pendientes",
            AlcanceDeServicio.ConsultaDePendientes,
            cuerpo,
            claveDeIdempotencia: null,
            conOrigen: false,
            texto =>
            {
                // Un cuerpo sin la propiedad no es «cero reservas»: una respuesta mal formada (un proxy, otra ruta, otra versión) falla cerrada, no abierta (IDE-27, IDE-70, IDE-84, IDE-88).
                using var documento = JsonDocument.Parse(texto);
                if (documento.RootElement.ValueKind != JsonValueKind.Object || !documento.RootElement.TryGetProperty("reservasActivas", out var propiedad) || propiedad.ValueKind != JsonValueKind.Number)
                {
                    throw new JsonException("Falta el conteo de reservas activas.");
                }

                var dto = JsonSerializer.Deserialize<PendientesDeTitularDto>(texto, Json) ?? throw new JsonException("La respuesta no es un conteo de pendientes.");
                return dto.ReservasActivas >= 0 ? new PendientesDeTitular(dto.ReservasActivas) : throw new JsonException("El conteo no puede ser negativo.");
            },
            cancelacion);
    }

    public async Task<ResultadoDelInventario> DarDeBajaAlTitular(Guid titularId, CancellationToken cancelacion = default)
    {
        if (titularId == Guid.Empty)
        {
            throw new ArgumentException("La baja necesita el identificador del titular.", nameof(titularId));
        }

        var cuerpo = JsonSerializer.Serialize(new BajaDeTitularDto(titularId), Json);
        var resultado = await Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/bajas-de-titular",
            AlcanceDeServicio.BajaDeTitular,
            cuerpo,
            claveDeIdempotencia: null,
            conOrigen: false,
            _ => true,
            cancelacion,
            HttpStatusCode.NoContent).ConfigureAwait(false);
        return resultado.Exitosa ? ResultadoDelInventario.Correcta : ComoSinValor(resultado);
    }

    public Task<ResultadoDelInventario<RespuestaDeConsultaPrevia>> ConsultarPrevia(ConsultaPrevia consulta, CancellationToken cancelacion = default)
    {
        ArgumentNullException.ThrowIfNull(consulta);
        ValidarLasLineas(consulta.Lineas, nameof(consulta));
        ValidarLaEntrega(consulta.Tipo, consulta.CodigoDeSucursalDeRecojo, consulta.RegionDeEntrega, nameof(consulta));

        var cuerpo = JsonSerializer.Serialize(new ConsultaPreviaDto(TextoDelTipo(consulta.Tipo), consulta.CodigoDeSucursalDeRecojo, consulta.RegionDeEntrega, ALasLineasDelContrato(consulta.Lineas)), Json);
        var pedidas = consulta.Lineas.ToDictionary(l => l.LineaId);
        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/reservas/consulta-previa",
            AlcanceDeServicio.LecturaDeDisponibilidad,
            cuerpo,
            claveDeIdempotencia: null,
            conOrigen: true,
            texto =>
            {
                var dto = JsonSerializer.Deserialize<ConsultaPreviaRespuestaDto>(texto, Json) ?? throw new JsonException("La respuesta no es una consulta previa.");
                var vistas = new HashSet<Guid>();
                var lineas = (dto.Lineas ?? throw new JsonException("Faltan las líneas.")).Select(l =>
                {
                    if (!pedidas.TryGetValue(l.LineaId, out var pedida) || pedida.EdicionId != l.EdicionId || !vistas.Add(l.LineaId) || l.DisponibleEnLaRed < 0 || l.PlazoEstimadoDias is < 0)
                    {
                        throw new JsonException("Una línea no es de las pedidas o no cumple el contrato.");
                    }

                    var disponible = l.Resultado == ResultadosDeSeleccion.Disponible;
                    return !disponible && l.Resultado != ResultadosDeSeleccion.SinStock
                        ? throw new JsonException("El resultado de una línea no es del contrato.")
                        : new SeleccionDeLineaDelInventario(l.LineaId, l.EdicionId, disponible, l.CodigoDeFuente, l.RequiereTraslado, l.PlazoEstimadoDias, l.DisponibleEnLaRed);
                }).ToList();
                return new RespuestaDeConsultaPrevia(lineas, dto.ConsultadaEn);
            },
            cancelacion,
            HttpStatusCode.OK);
    }

    public Task<ResultadoDelInventario<ReservaDelInventario>> Reservar(SolicitudDeReservaDeStock solicitud, string claveDeIdempotencia, CancellationToken cancelacion = default)
    {
        ArgumentNullException.ThrowIfNull(solicitud);
        if (solicitud.PedidoId == Guid.Empty)
        {
            throw new ArgumentException("La reserva necesita el identificador opaco del pedido.", nameof(solicitud));
        }

        ValidarLasLineas(solicitud.Lineas, nameof(solicitud));
        ValidarLaEntrega(solicitud.Tipo, solicitud.CodigoDeSucursalDeRecojo, solicitud.RegionDeEntrega, nameof(solicitud));
        if (string.IsNullOrEmpty(claveDeIdempotencia) || !ClaveValida.IsMatch(claveDeIdempotencia))
        {
            throw new ArgumentException("La clave de idempotencia tiene de 16 a 80 caracteres de [A-Za-z0-9_-].", nameof(claveDeIdempotencia));
        }

        var cuerpo = JsonSerializer.Serialize(new CrearReservaDto(solicitud.PedidoId, TextoDelTipo(solicitud.Tipo), solicitud.CodigoDeSucursalDeRecojo, solicitud.RegionDeEntrega, ALasLineasDelContrato(solicitud.Lineas)), Json);
        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/reservas",
            AlcanceDeServicio.OperacionDeUsuario,
            cuerpo,
            claveDeIdempotencia,
            conOrigen: false,
            texto => AReserva(JsonSerializer.Deserialize<ReservaDto>(texto, Json) ?? throw new JsonException("La respuesta no es una reserva."), solicitud.PedidoId, solicitud.Lineas.Select(l => l.LineaId).ToHashSet()),
            cancelacion,
            HttpStatusCode.Created);
    }

    public Task<ResultadoDelInventario<ReservaDelInventario>> Liberar(Guid pedidoId, string motivo, IReadOnlyList<Guid>? lineaIds = null, CancellationToken cancelacion = default)
    {
        if (pedidoId == Guid.Empty || !MotivosDeLiberacion.Todos.Contains(motivo) || lineaIds is not null && (lineaIds.Count > LimitesDeContrato.MaximoDeLineasPorReserva || lineaIds.Any(id => id == Guid.Empty)))
        {
            throw new ArgumentException("La liberación necesita el pedido, un motivo del contrato y, si lleva líneas, hasta el tope de líneas con identificador.");
        }

        var cuerpo = JsonSerializer.Serialize(new LiberarReservaDto(motivo, lineaIds is { Count: > 0 } ? [.. lineaIds] : null), Json);
        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/reservas/{pedidoId:D}/liberar",
            AlcanceDeServicio.ExpiracionDeReservas,
            cuerpo,
            claveDeIdempotencia: null,
            conOrigen: false,
            texto => AReserva(JsonSerializer.Deserialize<ReservaDto>(texto, Json) ?? throw new JsonException("La respuesta no es una reserva."), pedidoId, lineasPedidas: null),
            cancelacion,
            HttpStatusCode.OK);
    }

    private static void ValidarLasLineas(IReadOnlyList<LineaDeSolicitud> lineas, string parametro)
    {
        if (lineas is null || lineas.Count is 0 or > LimitesDeContrato.MaximoDeLineasPorReserva
            || lineas.Any(l => l.LineaId == Guid.Empty || l.EdicionId == Guid.Empty || l.Cantidad < 1)
            || lineas.Select(l => l.LineaId).Distinct().Count() != lineas.Count)
        {
            throw new ArgumentException($"La solicitud lleva de 1 a {LimitesDeContrato.MaximoDeLineasPorReserva} líneas distintas, con identificador y cantidad positiva.", parametro);
        }
    }

    private static void ValidarLaEntrega(TipoDeEntregaDeLaReserva tipo, string? sucursal, string? region, string parametro)
    {
        var correcta = tipo == TipoDeEntregaDeLaReserva.Recojo
            ? !string.IsNullOrWhiteSpace(sucursal) && string.IsNullOrWhiteSpace(region)
            : !string.IsNullOrWhiteSpace(region) && string.IsNullOrWhiteSpace(sucursal);
        if (!correcta)
        {
            throw new ArgumentException("El recojo lleva la sucursal y el domicilio, la región; nunca los dos.", parametro);
        }
    }

    public Task<ResultadoDelInventario<ReservaDelInventario>> ConsultarReserva(Guid pedidoId, CancellationToken cancelacion = default)
    {
        if (pedidoId == Guid.Empty)
        {
            throw new ArgumentException("La consulta necesita el pedido.", nameof(pedidoId));
        }

        return Pedir(
            HttpMethod.Get,
            $"{RutasDeServicio.Inventario}/reservas/{pedidoId:D}",
            AlcanceDeServicio.OperacionDeUsuario,
            cuerpo: null,
            claveDeIdempotencia: null,
            conOrigen: false,
            texto => AReserva(JsonSerializer.Deserialize<ReservaDto>(texto, Json) ?? throw new JsonException("La respuesta no es una reserva."), pedidoId, lineasPedidas: null),
            cancelacion,
            HttpStatusCode.OK);
    }

    public Task<ResultadoDelInventario<ExtensionDeLaReserva>> ExtenderReserva(Guid pedidoId, CancellationToken cancelacion = default)
    {
        if (pedidoId == Guid.Empty)
        {
            throw new ArgumentException("La extensión necesita el pedido.", nameof(pedidoId));
        }

        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/reservas/{pedidoId:D}/extender",
            AlcanceDeServicio.ExpiracionDeReservas,
            cuerpo: null,
            claveDeIdempotencia: null,
            conOrigen: false,
            texto =>
            {
                var dto = JsonSerializer.Deserialize<ExtensionDeReservaDto>(texto, Json) ?? throw new JsonException("La respuesta no es una extensión.");
                return new ExtensionDeLaReserva(dto.Extendida, AReserva(dto.Reserva ?? throw new JsonException("Falta la reserva."), pedidoId, lineasPedidas: null));
            },
            cancelacion,
            HttpStatusCode.OK);
    }

    public Task<ResultadoDelInventario<ReservaDelInventario>> ConfirmarReserva(Guid pedidoId, string claveDeIdempotencia, CancellationToken cancelacion = default)
    {
        if (pedidoId == Guid.Empty)
        {
            throw new ArgumentException("La confirmación necesita el pedido.", nameof(pedidoId));
        }

        if (string.IsNullOrEmpty(claveDeIdempotencia) || !ClaveValida.IsMatch(claveDeIdempotencia))
        {
            throw new ArgumentException("La clave de idempotencia tiene de 16 a 80 caracteres de [A-Za-z0-9_-].", nameof(claveDeIdempotencia));
        }

        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/reservas/{pedidoId:D}/confirmar",
            AlcanceDeServicio.ExpiracionDeReservas,
            cuerpo: null,
            claveDeIdempotencia,
            conOrigen: false,
            texto => AReserva(JsonSerializer.Deserialize<ReservaDto>(texto, Json) ?? throw new JsonException("La respuesta no es una reserva."), pedidoId, lineasPedidas: null),
            cancelacion,
            HttpStatusCode.OK);
    }

    public Task<ResultadoDelInventario<CierreDeLaReserva>> CerrarReserva(Guid pedidoId, string motivo, IReadOnlyList<Guid> lineaIds, Guid? envioId, string claveDeIdempotencia, CancellationToken cancelacion = default)
    {
        if (pedidoId == Guid.Empty
            || !MotivosDeCierre.Todos.Contains(motivo)
            || lineaIds is null || lineaIds.Count is 0 or > LimitesDeContrato.MaximoDeLineasPorReserva || lineaIds.Any(id => id == Guid.Empty) || lineaIds.Distinct().Count() != lineaIds.Count
            || (motivo == MotivosDeCierre.Reparto) != (envioId is not null && envioId != Guid.Empty)
            || (motivo == MotivosDeCierre.Entrega && envioId is not null))
        {
            throw new ArgumentException("El cierre necesita el pedido, un motivo del contrato, de 1 a las líneas máximas distintas y el envío solo cuando el motivo es el reparto.");
        }

        if (string.IsNullOrEmpty(claveDeIdempotencia) || !ClaveValida.IsMatch(claveDeIdempotencia))
        {
            throw new ArgumentException("La clave de idempotencia tiene de 16 a 80 caracteres de [A-Za-z0-9_-].", nameof(claveDeIdempotencia));
        }

        var cuerpo = JsonSerializer.Serialize(new CerrarReservaDto(motivo, [.. lineaIds], envioId), Json);
        var pedidas = lineaIds.ToHashSet();
        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/reservas/{pedidoId:D}/cerrar",
            AlcanceDeServicio.OperacionDeUsuario,
            cuerpo,
            claveDeIdempotencia,
            conOrigen: false,
            texto => ACierre(JsonSerializer.Deserialize<CierreDeReservaDto>(texto, Json) ?? throw new JsonException("La respuesta no es un cierre."), pedidoId, pedidas),
            cancelacion,
            HttpStatusCode.OK);
    }

    /// <summary>El cierre del contrato validado: el del pedido pedido, una línea por cada pedida (ni más ni menos) y un resultado de la lista cerrada.</summary>
    private static CierreDeLaReserva ACierre(CierreDeReservaDto dto, Guid pedidoId, HashSet<Guid> lineasPedidas)
    {
        var lineas = dto.Lineas ?? throw new JsonException("Faltan las líneas.");
        if (dto.PedidoId != pedidoId
            || lineas.Count != lineasPedidas.Count
            || lineas.Any(l => !lineasPedidas.Contains(l.LineaId) || !ResultadosDeCierre.Todos.Contains(l.Resultado))
            || lineas.Select(l => l.LineaId).Distinct().Count() != lineas.Count)
        {
            throw new JsonException("El cierre devuelto no es el del pedido, no cubre exactamente las líneas pedidas o trae un resultado fuera del contrato.");
        }

        return new CierreDeLaReserva(dto.PedidoId, [.. lineas.Select(l => new ResultadoDeCierreDeLinea(l.LineaId, l.Resultado))]);
    }

    private static string TextoDelTipo(TipoDeEntregaDeLaReserva tipo) => tipo == TipoDeEntregaDeLaReserva.Recojo ? TiposDeEntrega.Recojo : TiposDeEntrega.Domicilio;

    private static List<LineaDeSolicitudDto> ALasLineasDelContrato(IReadOnlyList<LineaDeSolicitud> lineas) => [.. lineas.Select(l => new LineaDeSolicitudDto(l.LineaId, l.EdicionId, l.Cantidad))];

    /// <summary>La reserva del contrato con sus valores validados: la del pedido pedido y, si se sabe, solo con líneas de las pedidas (la liberación no las conoce).</summary>
    private static ReservaDelInventario AReserva(ReservaDto dto, Guid pedidoId, HashSet<Guid>? lineasPedidas)
    {
        if (dto.PedidoId != pedidoId || string.IsNullOrWhiteSpace(dto.Estado) || !EstadosDeReserva.Todos.Contains(dto.Estado))
        {
            throw new JsonException("La reserva devuelta no es la del pedido o su estado no es del contrato.");
        }

        var lineas = (dto.Lineas ?? throw new JsonException("Faltan las líneas.")).Select(l =>
            l.LineaId == Guid.Empty || l.EdicionId == Guid.Empty || l.Cantidad < 1 || string.IsNullOrWhiteSpace(l.CodigoDeFuente) || l.PlazoEstimadoDias is < 0 || (lineasPedidas is not null && !lineasPedidas.Contains(l.LineaId))
                ? throw new JsonException("Una línea de la reserva no cumple el contrato o no es de las pedidas.")
                : new LineaReservada(l.LineaId, l.EdicionId, l.Cantidad, l.Estado ?? string.Empty, l.CodigoDeFuente, l.RequiereTraslado, l.PlazoEstimadoDias)).ToList();
        var traslados = (dto.Traslados ?? []).Select(t =>
            t.TrasladoId == Guid.Empty || t.Cantidad < 1 || string.IsNullOrWhiteSpace(t.CodigoDeOrigen) || string.IsNullOrWhiteSpace(t.CodigoDeDestino)
                ? throw new JsonException("Un traslado de la reserva no cumple el contrato.")
                : new TrasladoDeLaReserva(t.TrasladoId, t.EdicionId, t.Cantidad, t.CodigoDeOrigen, t.CodigoDeDestino, t.Estado ?? string.Empty, t.FechaEstimadaDeLlegada)).ToList();
        return new ReservaDelInventario(dto.PedidoId, dto.Estado, dto.CreadaEn, dto.ExpiraEn, lineas, traslados);
    }

    public Task<ResultadoDelInventario<ContactoDeSucursalDelInventario>> ConsultarContactoDeSucursal(string codigoDeSucursal, CancellationToken cancelacion = default)
    {
        // El código viaja en la ruta: solo se admite la forma de un código de sucursal (letras, dígitos, guion y guion bajo), nunca algo que cambie la ruta.
        if (string.IsNullOrWhiteSpace(codigoDeSucursal) || codigoDeSucursal.Length > 64 || !codigoDeSucursal.All(c => char.IsAsciiLetterOrDigit(c) || c is '-' or '_'))
        {
            throw new ArgumentException("El contacto se pide por un código de sucursal válido.", nameof(codigoDeSucursal));
        }

        return Pedir(
            HttpMethod.Get,
            $"{RutasDeServicio.Inventario}/sucursales/{codigoDeSucursal}/contacto-de-notificacion",
            AlcanceDeServicio.LecturaDeContacto,
            cuerpo: null,
    public Task<ResultadoDelInventario<ReingresoDeDevolucion>> ReingresarDevolucion(Guid devolucionId, Guid pedidoId, string codigoDeFuente, IReadOnlyList<LineaAReingresar> lineas, CancellationToken cancelacion = default)
    {
        if (devolucionId == Guid.Empty || pedidoId == Guid.Empty || string.IsNullOrWhiteSpace(codigoDeFuente)
            || lineas is null || lineas.Count is 0 or > MaximoDeLineasDeUnReingreso || lineas.Any(l => l is null || l.EdicionId == Guid.Empty || l.Cantidad < 1) || lineas.Select(l => l.EdicionId).Distinct().Count() != lineas.Count)
        {
            throw new ArgumentException("El reingreso necesita la devolución, el pedido, la fuente y de 1 a 20 líneas de ediciones distintas con cantidad positiva.");
        }

        var cuerpo = JsonSerializer.Serialize(new ReingresarDevolucionDto(pedidoId, codigoDeFuente, [.. lineas.Select(l => new LineaDeReingresoDto(l.EdicionId, l.Cantidad))]), Json);
        return Pedir(
            HttpMethod.Post,
            $"{RutasDeServicio.Inventario}/devoluciones/{devolucionId:D}/reingreso",
            AlcanceDeServicio.OperacionDeUsuario,
            cuerpo,
            claveDeIdempotencia: null,
            conOrigen: false,
            texto =>
            {
                var dto = JsonSerializer.Deserialize<ContactoDeSucursalDto>(texto, Json) ?? throw new JsonException("La respuesta no es un contacto de sucursal.");
                return string.IsNullOrWhiteSpace(dto.Codigo) || string.IsNullOrWhiteSpace(dto.Numero) || !string.Equals(dto.Codigo, codigoDeSucursal, StringComparison.OrdinalIgnoreCase)
                    ? throw new JsonException("El contacto no es el de la sucursal pedida.")
                    : new ContactoDeSucursalDelInventario(dto.Codigo, dto.Numero);
            },
            cancelacion);
    }

                // SEG-13: solo se acepta el reingreso de la devolución pedida.
                var dto = JsonSerializer.Deserialize<ReingresoDeDevolucionDto>(texto, Json) ?? throw new JsonException("La respuesta no es un reingreso.");
                return dto.DevolucionId == devolucionId ? new ReingresoDeDevolucion(dto.DevolucionId, dto.YaAplicado) : throw new JsonException("El reingreso devuelto no es el de la devolución pedida.");
            },
            cancelacion,
            HttpStatusCode.OK);
    }

    private const int MaximoDeLineasDeUnReingreso = 20;

    public Task<ResultadoDelInventario<IReadOnlyList<SucursalPublica>>> ListarSucursales(CancellationToken cancelacion = default) =>
        Pedir<IReadOnlyList<SucursalPublica>>(
            HttpMethod.Get,
            $"{RutasDeServicio.Inventario}/sucursales",
            AlcanceDeServicio.LecturaDeDisponibilidad,
            cuerpo: null,
            claveDeIdempotencia: null,
            conOrigen: false,
            texto =>
            {
                var dto = JsonSerializer.Deserialize<SucursalesDto>(texto, Json) ?? throw new JsonException("La respuesta no es una lista de sucursales.");
                var sucursales = (dto.Sucursales ?? throw new JsonException("Faltan las sucursales.")).Select(ASucursal).ToList();
                return sucursales.Select(s => s.Codigo).Distinct(StringComparer.Ordinal).Count() == sucursales.Count
                    ? sucursales
                    : throw new JsonException("Hay sucursales repetidas.");
            },
            cancelacion);

    private static ResultadoDelInventario ComoSinValor(ResultadoDelInventario<bool> resultado) =>
        resultado.Estado switch
        {
            EstadoDeLlamadaAlInventario.Rechazada => ResultadoDelInventario.Rechazo(resultado.EstadoHttp ?? 400, resultado.Codigo),
            EstadoDeLlamadaAlInventario.LimiteExcedido => ResultadoDelInventario.Limitada(resultado.Codigo),
            _ => ResultadoDelInventario.SinRespuesta,
        };

    private async Task<ResultadoDelInventario<T>> Pedir<T>(
        HttpMethod metodo,
        string ruta,
        AlcanceDeServicio alcance,
        string? cuerpo,
        string? claveDeIdempotencia,
        bool conOrigen,
        Func<string, T> leer,
        CancellationToken cancelacion,
        HttpStatusCode? exitoDelContrato = null)
        where T : notnull
    {
        using var solicitud = new HttpRequestMessage(metodo, ruta).ConAlcance(alcance);
        if (claveDeIdempotencia is not null)
        {
            solicitud.Headers.TryAddWithoutValidation(CabecerasDeServicio.ClaveDeIdempotencia, claveDeIdempotencia);
        }

        // Un POST se reintenta solo si lleva clave de idempotencia, es una consulta con cuerpo (EsLectura del contrato: disponibilidad y pendientes) o es la baja de un titular (repetirla no tiene efecto duplicado): el resto no se repite.
        if (claveDeIdempotencia is not null || (metodo == HttpMethod.Post && alcance is AlcanceDeServicio.LecturaDeDisponibilidad or AlcanceDeServicio.ConsultaDePendientes or AlcanceDeServicio.BajaDeTitular or AlcanceDeServicio.ExpiracionDeReservas))
        {
            solicitud.ComoIdempotente();
        }

        if (conOrigen)
        {
            solicitud.ConOrigenDelCliente();
        }

        if (cuerpo is not null)
        {
            solicitud.Content = new StringContent(cuerpo, Encoding.UTF8, "application/json");
        }

        try
        {
            var http = fabrica.CreateClient(NombreDelCliente);
            using var respuesta = await http.SendAsync(solicitud, HttpCompletionOption.ResponseHeadersRead, cancelacion).ConfigureAwait(false);
            var estado = (int)respuesta.StatusCode;

            if (respuesta.IsSuccessStatusCode)
            {
                // El contrato fija el código de éxito de cada operación (204, 201…): otro 2xx (un proxy, otra ruta) no se da por bueno.
                if (exitoDelContrato is { } esperado && respuesta.StatusCode != esperado)
                {
                    return ResultadoDelInventario<T>.SinRespuesta;
                }

                if (typeof(T) == typeof(bool))
                {
                    return (ResultadoDelInventario<T>)(object)ResultadoDelInventario<bool>.ConValor(true);
                }

                if (respuesta.StatusCode == HttpStatusCode.NoContent)
                {
                    return ResultadoDelInventario<T>.SinRespuesta;
                }

                var texto = await LeerAcotado(respuesta, MaximoDeBytesDeLaRespuesta, cancelacion).ConfigureAwait(false);
                return texto is null ? ResultadoDelInventario<T>.SinRespuesta : ResultadoDelInventario<T>.ConValor(leer(texto));
            }

            if (respuesta.StatusCode == HttpStatusCode.TooManyRequests)
            {
                var (codigoLimitado, textoLimitado) = await LeerProblema(respuesta, cancelacion).ConfigureAwait(false);
                return ResultadoDelInventario<T>.Limitada(codigoLimitado) with { Limite = LeerElLimite(textoLimitado) };
            }

            if (respuesta.StatusCode is HttpStatusCode.BadRequest or HttpStatusCode.Unauthorized or HttpStatusCode.Forbidden or HttpStatusCode.NotFound or HttpStatusCode.Conflict or HttpStatusCode.UnprocessableEntity)
            {
                var (codigoRechazado, textoRechazado) = await LeerProblema(respuesta, cancelacion).ConfigureAwait(false);
                var rechazo = ResultadoDelInventario<T>.Rechazo(estado, codigoRechazado);
                return codigoRechazado == CodigosDeErrorDelInventario.StockInsuficiente ? rechazo with { LineasSinStock = LeerLasLineasSinStock(textoRechazado) } : rechazo;
            }

            return ResultadoDelInventario<T>.SinRespuesta;
        }
        catch (OperationCanceledException) when (cancelacion.IsCancellationRequested)
        {
            throw;
        }
        catch (InvalidOperationException)
        {
            // Sin la sesión de la persona (el manejador del token no tiene a quién poner) o sin credencial configurada no se llama: es «no disponible», nunca una cabecera de actor.
            return ResultadoDelInventario<T>.SinRespuesta;
        }
        catch (Exception)
        {
            // Un corte, un plazo vencido, un cortacircuitos abierto o una respuesta que no cumple el contrato: «no disponible», sin el texto del error remoto.
            return ResultadoDelInventario<T>.SinRespuesta;
        }
    }

    /// <summary>El <c>code</c> estable de un <c>problem+json</c>, solo si tiene la forma de un código del contrato; nunca el título ni el detalle.</summary>
    private static async Task<(string? Codigo, string? Texto)> LeerProblema(HttpResponseMessage respuesta, CancellationToken cancelacion)
    {
        try
        {
            var texto = await LeerAcotado(respuesta, MaximoDeBytesDelProblema, cancelacion).ConfigureAwait(false);
            if (texto is null)
            {
                return (null, null);
            }

            var problema = JsonSerializer.Deserialize<ProblemaDto>(texto, Json);
            return (problema is { Code.Length: > 0 and <= 80 } && CodigoDeError.IsMatch(problema.Code) ? problema.Code : null, texto);
        }
        catch (Exception ex) when (ex is JsonException or RegexMatchTimeoutException or IOException or HttpRequestException)
        {
            return (null, null);
        }
    }

    /// <summary>Los datos de un 429 (<see cref="RespuestaDeLimiteDto"/>), solo si son válidos: la clave de la política, una espera de 0 a un día y el instante de reintento; si no, <see langword="null"/>.</summary>
    private static RechazoPorLimiteDelInventario? LeerElLimite(string? texto)
    {
        try
        {
            var dto = texto is null ? null : JsonSerializer.Deserialize<RespuestaDeLimiteDto>(texto, Json);
            return dto is { Motivo.Length: > 0 and <= 80, RetryAfterSeconds: >= 0 and <= 86_400 } ? new RechazoPorLimiteDelInventario(dto.Motivo, dto.RetryAfterSeconds, dto.DisponibleDesde) : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    /// <summary>Las líneas de un 409 de stock (<see cref="ProblemaDeStockDto"/>), solo si son válidas (cantidades positivas, a lo sumo las del tope del contrato); si no, <see langword="null"/>.</summary>
    private static IReadOnlyList<LineaSinStockDelInventario>? LeerLasLineasSinStock(string? texto)
    {
        try
        {
            var dto = texto is null ? null : JsonSerializer.Deserialize<ProblemaDeStockDto>(texto, Json);
            return dto is { Lineas.Count: > 0 and <= LimitesDeContrato.MaximoDeLineasPorReserva } && dto.Lineas.All(l => l.LineaId != Guid.Empty && l.EdicionId != Guid.Empty && l.Solicitada > 0 && l.DisponibleEnLaRed >= 0)
                ? [.. dto.Lineas.Select(l => new LineaSinStockDelInventario(l.LineaId, l.EdicionId, l.Solicitada, l.DisponibleEnLaRed))]
                : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

    /// <summary>El cuerpo como texto, con un tope de tamaño; <see langword="null"/> si lo supera.</summary>
    private static async Task<string?> LeerAcotado(HttpResponseMessage respuesta, int maximo, CancellationToken cancelacion)
    {
        if (respuesta.Content.Headers.ContentLength is { } largo && largo > maximo)
        {
            return null;
        }

        await using var flujo = await respuesta.Content.ReadAsStreamAsync(cancelacion).ConfigureAwait(false);
        using var memoria = new MemoryStream();
        var bloque = new byte[8192];
        int leidos;
        while ((leidos = await flujo.ReadAsync(bloque, cancelacion).ConfigureAwait(false)) > 0)
        {
            if (memoria.Length + leidos > maximo)
            {
                return null;
            }

            memoria.Write(bloque, 0, leidos);
        }

        return Encoding.UTF8.GetString(memoria.GetBuffer(), 0, (int)memoria.Length);
    }

    // ---------- Cuerpos del contrato (BabelHub.Shared) ----------

    private static DisponibilidadDeVariasEdiciones ADisponibilidad(string texto, HashSet<Guid> pedidas)
    {
        var dto = JsonSerializer.Deserialize<DisponibilidadDeEdicionesDto>(texto, Json) ?? throw new JsonException("La respuesta no es una disponibilidad.");
        var ediciones = (dto.Ediciones ?? throw new JsonException("Faltan las ediciones.")).Select(ADisponibilidadDeUna).ToList();
        var noRegistradas = (dto.NoRegistradas ?? throw new JsonException("Faltan las no registradas.")).ToList();
        var vistas = new HashSet<Guid>();
        var coherente = ediciones.All(e => pedidas.Contains(e.EdicionId) && vistas.Add(e.EdicionId))
            && noRegistradas.All(id => pedidas.Contains(id) && vistas.Add(id));
        return coherente ? new DisponibilidadDeVariasEdiciones(ediciones, noRegistradas) : throw new JsonException("La respuesta trae ediciones que no se pidieron o repetidas.");
    }

    private static DisponibilidadDeLaEdicion ADisponibilidadDeUna(DisponibilidadDeEdicionDto d)
    {
        var fuentes = (d.Fuentes ?? throw new JsonException("Faltan las fuentes.")).Select(f =>
        {
            if (string.IsNullOrWhiteSpace(f.CodigoDeFuente) || f.Vendible < 0 || !EstadosDeStock.Todos.Contains(f.EstadoDeStock))
            {
                throw new JsonException("Una fuente no cumple el contrato.");
            }

            return new FuenteConVendible(f.CodigoDeFuente, f.Nombre ?? string.Empty, f.Vendible, f.EstadoDeStock);
        }).ToList();
        return d.VendibleEnLaRed < 0 ? throw new JsonException("El vendible no puede ser negativo.") : new DisponibilidadDeLaEdicion(d.EdicionId, d.VendibleEnLaRed, fuentes, d.ConsultadaEn);
    }

    private static IngresoRegistrado AIngreso(IngresoDeMercaderiaDto d) =>
        d.IngresoId == Guid.Empty || d.EdicionId == Guid.Empty || string.IsNullOrWhiteSpace(d.CodigoDeFuente) || d.Cantidad is < LimitesDeContrato.IngresoMinimo or > LimitesDeContrato.IngresoMaximo
            ? throw new JsonException("Un ingreso no cumple el contrato.")
            : new IngresoRegistrado(d.IngresoId, d.EdicionId, d.CodigoDeFuente, d.Cantidad, d.Referencia, d.Nota, d.UsuarioId, d.Instante);

    private static SucursalPublica ASucursal(SucursalPublicaDto d) =>
        string.IsNullOrWhiteSpace(d.Codigo) || string.IsNullOrWhiteSpace(d.Nombre)
            ? throw new JsonException("Una sucursal no cumple el contrato.")
            : new SucursalPublica(d.Codigo, d.Nombre, d.Region ?? string.Empty);
}

/// <summary>Composición del cliente del Inventario (<see cref="IClienteDelInventario"/>) en el anfitrión.</summary>
public static class ComposicionDelClienteDelInventario
{
    /// <summary>
    /// Registra el cliente HTTP con nombre del Inventario (<see cref="HttpClienteDelInventario.NombreDelCliente"/>) con el plazo, los reintentos de lo idempotente y el cortacircuitos de
    /// <see cref="ClientesHttpDeServicio.AgregarClienteDeServicio"/>, <b>sin redirecciones</b> (la credencial de servicio y el token del usuario no deben viajar a otro destino) y sin los registros de
    /// petición del cliente. El anfitrión además registra las credenciales de salida (<see cref="OpcionesDeCredencialesDeSalida"/>) y el token de la sesión (<c>AgregarTokenDelUsuarioDeLaSesion</c>).
    /// </summary>
    public static IServiceCollection AgregarClienteDelInventario(this IServiceCollection servicios, Uri direccion, OpcionesDelClienteDeServicio? opciones = null)
    {
        ArgumentNullException.ThrowIfNull(servicios);
        ArgumentNullException.ThrowIfNull(direccion);
        var cliente = servicios.AgregarClienteDeServicio(HttpClienteDelInventario.NombreDelCliente, direccion, opciones);
        cliente.RemoveAllLoggers();
        cliente.ConfigurePrimaryHttpMessageHandler(() => new SocketsHttpHandler { AllowAutoRedirect = false });
        servicios.TryAddSingleton<IClienteDelInventario, HttpClienteDelInventario>();
        return servicios;
    }
}
