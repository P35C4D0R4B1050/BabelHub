                }
              }
            }
          },
          "429": {
            "description": "Error. Códigos estables posibles: `ECO-LIMITE-EXCEDIDO`.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemaDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "credencialDeServicio": [ ]
          }
        ],
        "x-operacion": "ecommerce.avisos.solicitar-del-inventario",
        "x-alcance": "solicitar-aviso"
      }
    },
