  "components": {
    "schemas": {
      "MarcarAlertaRevisadaDto": {
        "required": [
          "contadorVisto"
        ],
        "type": "object",
        "properties": {
          "contadorVisto": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          }
        }
      },
      "PaginaDeAlertasDto": {
        "required": [
          "alertas",
          "siguienteCursor"
        ],
        "type": "object",
        "properties": {
          "alertas": {
            "type": "array",
            "items": {
              "required": [
                "id",
                "servicio",
                "motivo",
                "clase",
                "primeraOcurrencia",
                "ultimaOcurrencia",
                "ocurrencias",
                "revisadasHasta",
                "revisadaPor",
                "revisadaEn"
              ],
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "servicio": {
                  "type": "string"
                },
                "motivo": {
                  "type": "string"
                },
                "clase": {
                  "type": "string"
                },
                "primeraOcurrencia": {
                  "type": "string",
                  "format": "date-time"
                },
                "ultimaOcurrencia": {
                  "type": "string",
                  "format": "date-time"
                },
                "ocurrencias": {
                  "pattern": "^-?(?:0|[1-9]\\d*)$",
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "format": "int32"
                },
                "revisadasHasta": {
                  "pattern": "^-?(?:0|[1-9]\\d*)$",
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "format": "int32"
                },
                "revisadaPor": {
                  "type": "string",
                  "format": "uuid",
                  "nullable": true
                },
                "revisadaEn": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                },
                "estado": {
                  "type": "string",
                  "nullable": true
                }
              }
            }
          },
          "siguienteCursor": {
            "type": "string",
            "nullable": true
          },
          "faltanDelInventario": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "PaginaDeRegistrosDto": {
        "required": [
          "registros",
          "siguienteCursor"
        ],
        "type": "object",
        "properties": {
          "registros": {
            "type": "array",
            "items": {
              "required": [
                "id",
                "servicio",
                "tipo",
                "tipoDeActor",
                "usuarioId",
                "rol",
                "instanteUtc",
                "accion",
                "resultado",
                "objetoTipo",
                "objetoId",
                "sucursalOrigen",
                "sucursalDestino",
                "motivo",
                "origen",
                "ruta",
                "detalle",
                "clavesPersonales",
                "truncado",
                "correlacion",
                "anonimizadoEn"
              ],
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "servicio": {
                  "type": "string"
                },
                "tipo": {
                  "type": "string"
                },
                "tipoDeActor": {
                  "type": "string"
                },
                "usuarioId": {
                  "type": "string",
                  "format": "uuid",
                  "nullable": true
                },
                "rol": {
                  "type": "string",
                  "nullable": true
                },
                "instanteUtc": {
                  "type": "string",
                  "format": "date-time"
                },
                "accion": {
                  "type": "string"
                },
                "resultado": {
                  "type": "string"
                },
                "objetoTipo": {
                  "type": "string",
                  "nullable": true
                },
                "objetoId": {
                  "type": "string",
                  "nullable": true
                },
                "sucursalOrigen": {
                  "type": "string",
                  "nullable": true
                },
                "sucursalDestino": {
                  "type": "string",
                  "nullable": true
                },
                "motivo": {
                  "type": "string",
                  "nullable": true
                },
                "origen": {
                  "type": "string",
                  "nullable": true
                },
                "ruta": {
                  "type": "string",
                  "nullable": true
                },
                "detalle": {
                  "type": "string",
                  "nullable": true
                },
                "clavesPersonales": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "nullable": true
                },
                "truncado": {
                  "type": "boolean"
                },
                "correlacion": {
                  "type": "string",
                  "nullable": true
                },
                "anonimizadoEn": {
                  "type": "string",
                  "format": "date-time",
                  "nullable": true
                }
              }
            }
          },
          "siguienteCursor": {
            "type": "string",
            "nullable": true
          },
          "cursorDeLaPagina": {
            "type": "string",
            "nullable": true
          },
          "faltanDelInventario": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "ProblemaDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "errores": {
            "type": "array",
            "items": {
              "required": [
                "campo",
                "clave"
              ],
              "type": "object",
              "properties": {
                "campo": {
                  "type": "string"
                },
                "clave": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "SolicitudDeAvisoDeInventarioDto": {
        "required": [
