# Normaliza los saltos de línea para trabajar igual en Windows, Linux y macOS.
* text=auto eol=lf

*.sln text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Binarios
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff2 binary
*.pdf binary

# Dependencias de la interfaz fijadas por huella SHA-256 (D09): se guardan byte a byte, sin normalizar saltos de línea.
src/BabelHub.Ecommerce/BabelHub.Ecommerce.Api/wwwroot/lib/** -text
