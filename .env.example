# Variables de entorno de ejemplo. Copia este archivo a `.env` (que NO se versiona) y ajusta los valores.
# Todos los valores de aquí son solo para desarrollo local.

# --- Bases de datos ---
# Una instancia PostgreSQL con una base y un rol por servicio: ecommerce e inventario (AD03).
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=cambiar-en-desarrollo
POSTGRES_ECOMMERCE_PASSWORD=cambiar-en-desarrollo
POSTGRES_INVENTARIO_PASSWORD=cambiar-en-desarrollo
POSTGRES_PORT=5432

# --- Caché ---
REDIS_PORT=6379

# --- Variables de los servicios (prefijo BABELHUB__; se agregan con cada feature) ---
# BABELHUB__PASARELA__CLAVE_PRIVADA=
# BABELHUB__ALMACEN__ENDPOINT=
# BABELHUB__NOTIFICADOR__WEBHOOK_URL=
# BABELHUB__LLM__API_KEY=
